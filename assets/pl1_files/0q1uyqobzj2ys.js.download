(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,351932,e=>{"use strict";var a=e.i(843476);e.i(271645);let n=[{id:"civil",slug:"civil",name:"Civil Engineering",fullName:"Civil Engineering",established:1983,intake:60,duration:"3 Years",syllabus:"/assets/departments/CIVIL/R-2023 CIVIL SYLLABUS FINAL.pdf",image:"https://images.unsplash.com/photo-1541888946425-d81bb19240f5?auto=format&fit=crop&w=600&q=80",slogan:"Shaping the world, building the future.",description:"The Department of Civil Engineering is committed to producing competent diploma engineers equipped with technical knowledge, practical skills, professional ethics, and lifelong learning abilities. The programme is designed in accordance with the Directorate of Technical Education (DOTE), Tamil Nadu, Regulation 2023, and focuses on planning, design, construction, maintenance, and management of infrastructure projects.",overviewBullets:["The Department of Civil Engineering was established in 1983.","The department has an annual intake of 60 students.","It has been offering quality technical education in the field of Civil Engineering for the past four decades.","The curriculum provides comprehensive knowledge in structural engineering, surveying, construction materials, hydraulics, and more.","Students gain extensive practical exposure through laboratories, field surveys, industrial training, and internships."],vision:"To develop competent civil engineering professionals with strong technical knowledge, practical skills, leadership qualities, and ethical values.",mission:["Deliver quality civil engineering education and practical training.","Enhance field exposure through industrial visits and internships.","Develop personality, communication, and leadership skills.","Promote industry interaction and employability skills.","Foster innovation, professionalism, and social responsibility."],labs:["Concrete and Construction Practice Laboratory","Strength of Materials Lab","Hydraulics laboratory","Surveying Laboratory with Total Stations"],careers:["State Government Jobs (AE in PWD, Highways, Rural Development, Water Resources, Municipal Corps)","Central Government Jobs (Indian Railways, CPWD, NHAI, MES, Border Roads)","Private Construction & Infrastructure Companies (Site, Project, Planning, QC Engineers at L&T, Shapoorji Pallonji, Tata Projects)","Consultancy, Design, and Research (Design, Survey Engineers, Structural Consultants)","Entrepreneurship (Consultancy firms, contracting business, surveying, material testing)"],keyStrengths:["Experienced and dedicated faculty members.","Well-equipped laboratories with modern experimental setups.","Industry-oriented curriculum and practical training.","Strong focus on hands-on learning and skill development.","Excellent career opportunities in public, private, and entrepreneurship sectors."],hodMessage:"The Department of Civil Engineering, established in 1983, has been functioning with excellence and dedication towards producing competent engineers required for the nation's infrastructure development. Our department provides students with a strong academic foundation in areas such as building construction, roads, bridges, water resources management, environmental engineering, surveying, construction management, and modern construction technologies. We continuously focus on enhancing both the theoretical knowledge and practical skills of our students through well-equipped laboratories, field visits, industrial training, seminars, workshops, and project-based learning activities. Our experienced faculty members are committed to guiding students in developing technical expertise, problem-solving abilities, leadership qualities, time management skills, project coordination capabilities, and professional ethics. The achievements of our students, including securing admissions in premier institutions for higher education, obtaining placements in reputed organizations, and winning prizes in various technical competitions conducted by different colleges, stand as proud milestones of our department. Our primary objective is to nurture skilled, responsible, and socially conscious engineers who can effectively meet the evolving demands of the construction industry. I encourage every student to make the best use of the opportunities provided by the department and the institution and strive for excellence in both their academic and professional careers. \"The power of Civil Engineering lies in transforming yesterday's dreams into today's structures.\"",faculty:[{name:"D. Satheesh",designation:"HOD",doj:"29.05.2013",dob:"11.07.1991",qualification:"M.E.",experience:"13 Years 1 Month",phone:"9688854014",image:"/assets/departments/Faculty/TEACHING kpc/CIVIL/Sathish.webp"},{name:"M. Sakthimurugan",designation:"Senior Lecturer",doj:"18.11.2015",dob:"03.05.1986",qualification:"M.E.",experience:"10 Years 5 Months",phone:"9994013175",image:"/assets/departments/Faculty/TEACHING kpc/CIVIL/sakthimurugan.webp"},{name:"B. Dineshkumar",designation:"Senior Lecturer",doj:"28.11.2018",dob:"05.04.1988",qualification:"M.E.",experience:"7 Years 5 Months",phone:"9443338987",image:"/assets/departments/Faculty/TEACHING kpc/CIVIL/Dinesh.webp"},{name:"M.C. Akilarasu",designation:"Lecturer",doj:"06.09.2021",dob:"28.10.1996",qualification:"M.E.",experience:"4 Years 9 Months",phone:"8883770077",image:"/assets/departments/Faculty/TEACHING kpc/CIVIL/akilarasu.webp"},{name:"K.R. Ponnsahana",designation:"Lecturer",doj:"05.06.2023",dob:"21.08.1997",qualification:"M.E.",experience:"3 Years 0 Months",phone:"9445914002",image:"/assets/departments/Faculty/TEACHING kpc/CIVIL/ponshahana.webp"},{name:"C. Veeramani",designation:"Senior Technical Assistant",doj:"06.06.2017",dob:"06.07.1999",qualification:"D.C.E.",experience:"9 Years 1 Month",phone:"7402626902",image:"/assets/departments/Faculty/NONTEACHING kpc/CIVIL/veeramani.webp"},{name:"M. Boopathisankar",designation:"Lab Assistant",doj:"01.06.2023",dob:"12.09.1994",qualification:"D.C.E.",experience:"3 Years 1 Month",phone:"9790641006",image:"/assets/departments/Faculty/NONTEACHING kpc/CIVIL/boopathi.webp"}],alumni:[{name:"Jayachandran K",batch:"2002 - 2005 Batch",salary:"-",position:"Assistant Professor in Civil Engineering",company:"National Institute of Technology Calicut (NIT Calicut)",location:"Kozhikode, Kerala",image:"/assets/departments/CIVIL/Jayachandran K.webp"},{name:"MK Pillai",batch:"1986 - 1989 Batch",salary:"-",position:"Vice President (Projects)",company:"ECR Buildtech Pvt Ltd",location:"New Delhi",image:"/assets/departments/CIVIL/MK Pillai.webp"},{name:"Vimal Kumar Mani",batch:"1986 - 1987 Batch",salary:"-",position:"Project Manager",company:"Al Balagh Trading and Contracting Co.W.L.L",location:"Doha Qatar",image:"/assets/departments/CIVIL/Vimal kumar Mani.webp"},{name:"Bharathvasan J M",batch:"2017 - 2020 Batch",salary:"-",position:"Executive Planning Engineer",company:"Renaatus projects Pvt. Ltd.",location:"Maldives",image:"/assets/departments/CIVIL/Bharathvasan JM.webp"},{name:"SARAN G",batch:"2017 - 2020 Batch",salary:"-",position:"Steel Detailer",company:"BCad Global - Engineering Service & BIM",location:"Coimbatore",image:"/assets/departments/CIVIL/Saran G.webp"},{name:"Kailasam",batch:"2012 - 2015 Batch",salary:"-",position:"Partner",company:"A1 Building Materials",location:"Muthampalayam",image:"/assets/departments/CIVIL/Kailasam.webp"},{name:"Tarunya A",batch:"2018 - 2021 Batch",salary:"-",position:"Procurement Engineer",company:"Sanctuary Spaces",location:"Surampatti Valasu, Erode",image:"/assets/departments/CIVIL/Tarunya A.webp"},{name:"Naveen Kumar VR",batch:"2012 - 2015 Batch",salary:"-",position:"Managing Director",company:"Shree Kumaran Constructions",location:"Tirupur",image:"/assets/departments/CIVIL/Naveen Kumar VR.webp"},{name:"Sonaanjali",batch:"2020 - 2023 Batch",salary:"-",position:"Associate Designer",company:"Kellogg brown and root (KBR)",location:"Chennai",image:"/assets/departments/CIVIL/Sonaanjali.webp"},{name:"M.Mohanaprasath",batch:"2012 - 2015 Batch",salary:"-",position:"Principal architect",company:"MRK DESIGN STUDIO",location:"Erode",image:"/assets/departments/CIVIL/Mohanaprasath.webp"},{name:"Rithik.P.D",batch:"2017 - 2020 Batch",salary:"-",position:"Junior modular & Erection editer",company:"Matrix Steel Solutions",location:"Coimbatore",image:"/assets/departments/CIVIL/Rithik PD.webp"}],events:[{date:"21 Feb 2026",title:"Special Lecture on 'Future scope of Civil Engineering'",type:"Special Lecture",speaker:"Er. D. Karthigeyan",designation:"Managing Director",organization:"DRS Designers, Karungalpalayam, Erode",venue:"Dheeran Chinnamalai Seminar Hall",time:"10:30 A.M.",outcomes:["Identify diverse career opportunities in Civil Engineering.","Understand future trends and emerging technologies in the construction industry.","Explore options in higher studies, government jobs, and private-sector employment.","Recognize entrepreneurship and consultancy opportunities in civil engineering.","Develop skills aligned with future industry requirements."]},{date:"09 Oct 2025",title:"Workshop on 'Land Record management and modern survey techniques'",type:"Workshop",speaker:"V. Muthuraja & S.S. Manisekaran",designation:"Directors",organization:"Institute of Land Management and Research, Coimbatore",venue:"Dheeran Chinnamalai Seminar Hall",time:"08:45 A.M. to 04:30 P.M.",outcomes:["Understand land record management systems and their applications.","Interpret land records, maps, and survey documents.","Gain hands-on knowledge of modern surveying instruments and technologies.","Apply GPS, GIS, Total Station, and drone surveying techniques.","Develop field surveying and data analysis skills."]},{date:"11 Aug 2025",title:"Special Lecture on 'Civil Engineering Challenges in Urban Infrastructure Development'",type:"Special Lecture",speaker:"Er. T. Govindaraj B.E.",designation:"Managing Director",organization:"GMD Venture Private Limited, Erode",venue:"English Communication Lab, KPC",time:"10:30 A.M.",outcomes:["Demonstrate a comprehensive understanding of the construction industry layout.","Understand and apply administrative, technical, and statutory procedures involved in government projects.","Identify, analyze, and evaluate challenges encountered in construction projects.","Apply engineering principles to address real-world civil engineering challenges.","Utilize modern engineering tools and construction techniques effectively."]},{date:"07 Jul 2025",title:"Field Visit to Water Treatment Plant",type:"Field Visit",location:"TWAD Board - Pillur III Water treatment plant, Maruthur, Coimbatore",participants:"Civil Engineering Students and Faculty Members",venue:"TWAD Board Water Treatment Plant",outcomes:["Understand the working principles of a water treatment plant.","Identify various water treatment processes and units.","Relate classroom concepts to practical water supply engineering applications.","Learn water quality testing and monitoring procedures.","Understand the role of TWAD Board in public water supply management."]}],achievements:[{year:"2025",title:"Best Department Award",desc:"Recognized for outstanding academic performance and consistent board examination results."},{year:"2024",title:"Symposium Top Honors",desc:"Civil Engineering students won multiple first and second prizes in state-level paper presentation and concrete technology contests."},{year:"2024",title:"Industrial Partnerships",desc:"Signed strategic MoUs with prominent local structural consultancies and construction firms to facilitate internships and training."}],ivGallery:[{src:"/assets/departments/CIVIL/Event-1Inaugural Function image.webp",title:"Special Guest Address",desc:"Special guest addressing Civil Engineering students at KPC."},{src:"/assets/departments/CIVIL/Event-1Inaugural Function image 1.webp",title:"Students Seminar",desc:"Civil Engineering department seminar in progress."},{src:"/assets/departments/CIVIL/Two day workshop on surveying.webp",title:"Workshop Session",desc:"Hands-on survey and land record management workshop."},{src:"/assets/departments/CIVIL/Two day workshop on surveying img 2.webp",title:"Testing Work in Lab",desc:"Students performing concrete and highway material testing."},{src:"/assets/departments/CIVIL/Special Lecture on “Future scope of Civil Engineering.webp",title:"Material Strength Testing",desc:"Hands-on experiments in the Strength of Materials Laboratory."},{src:"/assets/departments/CIVIL/Special Lecture on “Future scope of Civil Engineering img1.webp",title:"Surveying Laboratory",desc:"Field surveying exercises using modern Total Stations."},{src:"/assets/departments/CIVIL/FIELD VISIT 2025-2026.webp",title:"TWAD Plant Field Visit",desc:"Field visit to the TWAD Board Pillur III Water Treatment Plant."},{src:"/assets/departments/CIVIL/FIELD VISIT 2025-2026 img 2.webp",title:"WTP Process Site Visit",desc:"Students observing process technology at the Water Treatment Plant."}],labGallery:[{src:"/assets/departments/selected/civil selected/CIVIL (5).webp",title:"Material Testing Laboratory",desc:"Testing strength of concrete and construction materials."},{src:"/assets/departments/selected/civil selected/CIVIL (6).webp",title:"Surveying Practice Lab",desc:"Modern surveying equipment, theodolites, and total stations."},{src:"/assets/departments/selected/civil selected/CIVIL (7).webp",title:"Hydraulics laboratory",desc:"Fluid mechanics and hydraulic machinery testing apparatus."},{src:"/assets/departments/selected/civil selected/CIVIL (10).webp",title:"CAD in Civil Engineering Lab",desc:"CAD, drafting, and structural analysis workstation lab."},{src:"/assets/departments/selected/civil selected/CIVIL (13).webp",title:"Soil Mechanics & Construction Lab",desc:"Soil properties and construction materials testing setup."},{src:"/assets/departments/selected/civil selected/CIVIL (19).webp",title:"Structural Engineering Design Practice",desc:"Structural analysis and practical testing facility."}],icon:(0,a.jsxs)("svg",{className:"w-6 h-6",fill:"none",stroke:"url(#dg-civil)",strokeWidth:"2",viewBox:"0 0 24 24",children:[(0,a.jsx)("defs",{children:(0,a.jsxs)("linearGradient",{id:"dg-civil",x1:"0%",y1:"0%",x2:"0%",y2:"100%",children:[(0,a.jsx)("stop",{offset:"0%",stopColor:"#91C04A"}),(0,a.jsx)("stop",{offset:"100%",stopColor:"#009EDB"})]})}),(0,a.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",d:"M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"})]})},{id:"mech",slug:"mech",name:"Mechanical Engineering",fullName:"Mechanical Engineering",established:1983,intake:120,duration:"3 Years",syllabus:"/assets/departments/MECH/Syllabus R-2023 Scheme.pdf",image:"https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=80",slogan:"Powering progress, engineering motion.",description:"The Department of Mechanical Engineering was established in 1983 and has an annual intake of 120 students. Our department is a place where innovation, creativity, and practical learning come together. We are committed to providing quality education and industry-focused training to help students build successful careers in engineering. Through modern laboratories, workshops, projects, industrial visits, and skill development programs, we prepare students to face real-world challenges with confidence.",overviewBullets:["The Department of Mechanical (DME) was established in 1983.","The department has an annual intake of 120 students.","The department has been providing quality technical education in the field of Mechanical Engineering for many years.","It imparts strong theoretical knowledge and practical skills to students.","The department prepares students with industry-oriented expertise to meet the challenges of modern engineering.","The department provides knowledge in core areas of Mechanical Engineering, including design, manufacturing, and thermal sciences.","Students learn about: Machine Design, Manufacturing Processes, Fluid Mechanics, Thermal Engineering, and Automobile Engineering.","The curriculum includes basic concepts of: Computer-Aided Design (CAD), Mechatronics, and Robotics & Automation.","The department provides hands-on training through laboratories, workshops, and industrial visits.","The department helps students develop technical, analytical, and practical skills required for the engineering industry."],vision:"To be regionally, nationally and internationally recognized in providing mechanical engineering education leading to well qualified engineers who are innovative, immediate contributors to their profession and successful in advanced studies.",mission:["To educate, prepare, inspire and mentor students to excel as professionals and to grow throughout their careers in the art, science and responsibilities of engineering.","Engaging in academic and scholarly activities which strengthen the major’s regional, national and international reputation."],labs:["Lathe & Special Machines Shop","Thermal & Fluid Engineering Lab","Computer Aided Design (CAD/CAM) Lab","CNC Programming & Machining Centre"],careers:["Graduates can work in manufacturing, automotive, aerospace, and energy industries.","They can become Design, Production, Quality, Maintenance, or Project Engineers.","Opportunities exist in automobile companies, power plants, and heavy industries. They can join PSUs, government sectors, and research organizations.","They can pursue higher studies, entrepreneurship, or advanced technology fields like robotics and automation."],keyStrengths:["Strong foundation in Mechanical Engineering fundamentals.","Well-equipped labs and workshop facilities.","Experienced and qualified faculty members.","Industry exposure through internships and visits.","Focus on technical and problem-solving skills."],hodMessage:"Welcome to the Department of Mechanical Engineering. The Department of Mechanical Engineering was established in 1983 and has an annual intake of 120 students. Our department is a place where innovation, creativity, and practical learning come together. We are committed to providing quality education and industry-focused training to help students build successful careers in engineering. Through modern laboratories, workshops, projects, industrial visits, and skill development programs, we prepare students to face real-world challenges with confidence. Our dedicated faculty members guide and inspire students to achieve academic excellence, develop technical expertise, and uphold professional values. We encourage every student to explore, learn, innovate, and grow into a responsible engineer and future leader.",faculty:[{name:"P. Sarvalingamoorthy",designation:"Head of the Department",doj:"06-05-2009",dob:"23-11-1985",qualification:"M.E., MISTE.,",experience:"17 Years 1 Month",phone:"7200607007",image:"/assets/departments/Faculty/TEACHING kpc/MECH/sarvalingamoorthy.webp"},{name:"G. Karthikeyan",designation:"SG1 Lecturer",doj:"30-06-2008",dob:"01-01-1980",qualification:"M.E., MISTE.,",experience:"17 Years 11 Months",phone:"9994025210",image:"/assets/departments/Faculty/TEACHING kpc/MECH/karthikeyan.webp"},{name:"C. Meiyalagan",designation:"SG1 Lecturer",doj:"20-05-2010",dob:"28-02-1979",qualification:"M.E., MISTE.,",experience:"16 Years 1 Month",phone:"7708038687",image:"/assets/departments/Faculty/TEACHING kpc/MECH/meiyalagan.webp"},{name:"S. Gowrisankar",designation:"SG1 Lecturer",doj:"01-06-2011",dob:"01-06-1976",qualification:"M.E., MISTE.,",experience:"15 Years 1 Month",phone:"9994057720",image:"/assets/departments/Faculty/TEACHING kpc/MECH/Gowrishankar S.webp"},{name:"K. Ravichandran",designation:"SG1 Lecturer",doj:"20-05-2010",dob:"25-04-1974",qualification:"M.E., MISTE.,",experience:"16 Years 1 Month",phone:"9976583999",image:"/assets/departments/Faculty/TEACHING kpc/MECH/ravichandran.webp"},{name:"A. Shanmugasundaram",designation:"SG1 Lecturer",doj:"09-05-2013",dob:"03-03-1972",qualification:"AMIE., M.E., MISTE.,",experience:"13 Years 1 Month",phone:"6381723793",image:"/assets/departments/Faculty/TEACHING kpc/MECH/shanmugasundaran.webp"},{name:"Capt R.Premkumar",designation:"Sr. Lecturer / NCC Officer",doj:"10-10-2011",dob:"04-02-1989",qualification:"B.E., MISTE.,",experience:"14 Years 8 Months",phone:"9952760017",image:"/assets/departments/Faculty/TEACHING kpc/MECH/premkumar.webp"},{name:"N. Gowrisankar",designation:"Sr. Lecturer",doj:"15-05-2013",dob:"20-06-1986",qualification:"B.E., MISTE.,",experience:"13 Years 1 Month",phone:"7810053583",image:"/assets/departments/Faculty/TEACHING kpc/MECH/gowrisankar N.webp"},{name:"P. Myilsamy",designation:"Sr. Lecturer",doj:"27-05-2013",dob:"02-11-1988",qualification:"B.E., MISTE.,",experience:"13 Years 1 Month",phone:"9715531507",image:"/assets/departments/Faculty/TEACHING kpc/MECH/mayilsamy.webp"},{name:"A. Shanmugam",designation:"Senior Programmer",doj:"09-06-2008",dob:"10-05-1986",qualification:"D.C.S.E.,",experience:"18 Years 1 Month",phone:"9524240687",image:"/assets/departments/Faculty/NONTEACHING kpc/MECH/shanmugam.webp"},{name:"S. Jagadeesh",designation:"Sr. Tech Assistant",doj:"06-06-2008",dob:"14-06-1981",qualification:"I.T.I",experience:"19 Years 1 Month",phone:"9750839395",image:"/assets/departments/Faculty/NONTEACHING kpc/MECH/jagadeesh.webp"},{name:"J. Eswaran",designation:"Lab Assistant",doj:"01-09-2016",dob:"10-06-1983",qualification:"I.T.I",experience:"9 Years 9 Months",phone:"9788617857",image:"/assets/departments/Faculty/NONTEACHING kpc/MECH/eswaran.webp"},{name:"A. Raja",designation:"Lab Assistant",doj:"06-09-2021",dob:"09-12-1997",qualification:"D.M.E.,",experience:"4 Years 9 Months",phone:"8270014145",image:"/assets/departments/Faculty/NONTEACHING kpc/MECH/raja.webp"},{name:"S. Naveen Kumar",designation:"Lab Assistant",doj:"01-11-2025",dob:"05-04-1999",qualification:"D.M.E.,",experience:"0 Years 7 Months",phone:"6374934473",image:"/assets/departments/Faculty/NONTEACHING kpc/MECH/naveen.webp"}],alumni:[{name:"KUMARAGURUBARAN S B",batch:"2006 – 2009 Batch",salary:"12 Lakh/Annum",position:"Assistant Manager",company:"International Centre for Automotive Technology (ICAT)",location:"Gurgaon",image:"/assets/departments/MECH/Kumaragurubaran SB.webp"},{name:"MANOJ KUMAR B",batch:"2006 – 2009 Batch",salary:"9.6 Lakh/Annum",position:"Assistant Lead Engineer",company:"Vestas Technology R&D Chennai Private Limited",location:"Chennai",image:"/assets/departments/MECH/Manojkumar B.webp"},{name:"MALAR MANNAN A",batch:"2008 – 2010 Batch",salary:"8.5 Lakh/Annum",position:"Senior Engineer",company:"A.A.Hr.Sec School, Viriyur",location:"Coimbatore",image:"/assets/departments/MECH/Malar Mannan A.webp"},{name:"SYED FAZIL",batch:"2009 – 2012 Batch",salary:"16 Lakh/Annum",position:"Proprietor",company:"D Agri Organics",location:"Pollachi",image:"/assets/departments/MECH/Syed Fazil.webp"},{name:"O. SELVARAJ",batch:"1990 – 1993 Batch",salary:"24 Lakh/Annum",position:"Sr. Manager - Mechanical",company:"JSW Steel Ltd Salem Works",location:"Salem",image:"/assets/departments/MECH/Selvaraj O.webp"},{name:"JAGADEES",batch:"2016 – 2019 Batch",salary:"7.6 Lakh/Annum",position:"Jr.Inspector",company:"BULL Machines",location:"Sulur, Coimbatore",image:"/assets/departments/MECH/Jagadees.webp"},{name:"K.C. KANNAN",batch:"1990 – 1993 Batch",salary:"9.6 Lakh/Annum",position:"HOD Testing",company:"L&T Energy Hydro Carbon Modular Fabrication Facility Limited",location:"SEZ Kattupalli, Chennai",image:"/assets/departments/MECH/K C Kannan.webp"},{name:"MUKILAN R",batch:"2021 – 2024 Batch",salary:"5.1 Lakh/Annum",position:"Junior Design Engineer",company:"Research Supporters, India",location:"Maruthi Nager, Hosur",image:"/assets/departments/MECH/Mukilan R.webp"}],achievements:[{year:"2026",title:"Paper Presentations - Top Prizes",desc:"Students won multiple prizes at various colleges: Mohan A & Thanush M R won 3rd prize at EIT Kavindapadi; Utthaman M R & Jegan D won 1st prize at Shree Venkateshwara Gobi and 1st prize at PA Pollachi; Mohan A & Praneesh L & Boopesh S won 1st prize at Nandha Perundurai; Bharathi Selvan B J & Durgesh E M won 2nd prize at Chendhuran Pudhukottai; Utthaman M R & Vignesh P won 3rd prize at Chendhuran Pudhukottai; and others.",images:["/assets/departments/MECH/Mohan A.webp","/assets/departments/MECH/Thanush MR.webp","/assets/departments/MECH/UTTHAMAN MR.webp","/assets/departments/MECH/Jegan D.webp","/assets/departments/MECH/Praneesh L.webp","/assets/departments/MECH/Boopesh S.webp","/assets/departments/MECH/Bharathi Selvan BJ.webp","/assets/departments/MECH/Durgesh EM.webp","/assets/departments/MECH/Vignesh P.webp","/assets/departments/MECH/Bhuvan Karthick M.webp"]},{year:"2026",title:"Sports Activities - Outstanding Honors",desc:"Jegan D & Bharathi Selvan B J secured 1st in Table Tennis (Divisional) and 3rd in State. Jegan D (205th) and Arunkarthik K (220th) placed in International FIDE Chess. Vignesh K secured 2nd in High Jump (Divisional) and 4th in State. Jegan D & Arun Karthick K won 1st in Chess (Divisional) & State. Manikandan R secured 1st in Basketball (Divisional) & 3rd in State. Bharathi Selvan B J & Dharshan A won 1st in Ball Badminton (Divisional) & 3rd in State. And more honors in Volleyball, Kho Kho, Handball, and Athletics.",images:["/assets/departments/MECH/Jegan D.webp","/assets/departments/MECH/Bharathi Selvan BJ.webp","/assets/departments/MECH/ArunKarthik k.webp","/assets/departments/MECH/Vignesh K.webp","/assets/departments/MECH/Manikandan R.webp","/assets/departments/MECH/Dharshan A.webp","/assets/departments/MECH/Barani K.webp","/assets/departments/MECH/Dharshan K.webp","/assets/departments/MECH/Sabarish I.webp","/assets/departments/MECH/Saran C.webp"]},{year:"2026",title:"Best Outgoing Student Award",desc:"Jegan D was selected in Tamil Nadu Team, awarded Best ISTE Student, and emerged as the topper of the Mechanical Engineering department.",images:["/assets/departments/MECH/Jegan D.webp"]}],ivGallery:[{src:"/assets/departments/MECH/Additional Skills need in Industries for current scenario.webp",title:"Industrial Skills Lecture",desc:"Special guest lecture on industrial skills by JSW Salem Manager."},{src:"/assets/departments/MECH/The Robotics Society.webp",title:"Robotics Society Workshop",desc:"Robotics society workshop at Mechatronics Engineering lab."},{src:"/assets/departments/MECH/Solid works.webp",title:"SolidWorks & 3D Printing",desc:"Hands-on SolidWorks design and 3D printing workshop."},{src:"/assets/departments/MECH/Naan mudhalvan FV.webp",title:"Sakthi Auto Components Visit",desc:"Field visit to Sakthi Auto Component Limited in Pallagounden Palayam."},{src:"/assets/departments/MECH/Design Thinking.webp",title:"Athikadavu Avinashi Project Visit",desc:"Field visit to Athikadavu Avinashi irrigation project site in Bhavani."},{src:"/assets/departments/MECH/Event 6.webp",title:"SRS CNC Machining Visit",desc:"CNC machining and programming training field visit at SRS CNC."}],events:[{date:"19 Feb 2026",title:"Guest Lecture on 'Design Thinking'",type:"Guest Lecture",speaker:"Mr. S. Santhosh Kumar, M.E.",designation:"Assistant Professor (Ex Design Engineer Royal Enfield)",organization:"Kongu Engineering College, Perundurai",venue:"Kalingarayan Seminar Hall",time:"10:00 A.M.",outcomes:["Apply engineering knowledge to solve real-world problems.","Design and develop effective engineering solutions.","Use modern tools and technologies in engineering practice.","Work effectively in teams and communicate clearly.","Follow professional ethics and engage in lifelong learning."]},{date:"07 Oct 2025",title:"One Day Workshop on 'Solid Work & 3D Printing'",type:"Workshop",speaker:"Mr. A. Saravanan, M.E.",designation:"Assistant Professor",organization:"Kongu Engineering College, Perundurai",venue:"CAD Centre, Department of Mechanical Engineering",time:"10:00 A.M. to 04:00 P.M.",outcomes:["Understand the basics of SolidWorks software.","Create simple 3D models using SolidWorks.","Learn the fundamentals of 3D printing technology.","Gain hands-on experience in design and printing.","Understand real-world applications of 3D printing."]},{date:"16 Sep 2025",title:"One Day Workshop on 'The Robotics Society'",type:"Workshop",speaker:"Dr. T. Tamilarasi, M.E., Ph.D",designation:"Associate Professor",organization:"Kongu Engineering College, Perundurai",venue:"Robotics Laboratory, Department of Mechatronics Engineering",time:"10:00 A.M. to 04:00 P.M.",outcomes:["Understand the basic concepts of robotics.","Learn the key components and working of robots.","Develop problem-solving and analytical skills.","Gain practical hands-on experience in robotics.","Understand the real-world applications of robotics."]},{date:"25 Jul 2025",title:"Field Visit to Athikadavu Avinashi Project",type:"Field Visit",location:"Bavani",participants:"Mechanical Students and Faculty Members",venue:"Athikadavu Avinashi Project",outcomes:["Understand the objectives and benefits of the Athikadavu Avinashi Project.","Learn about water resource management techniques.","Understand groundwater recharge and conservation methods.","Gain knowledge of large-scale irrigation projects.","Recognize the social and environmental impact of the project."],industryExposure:"Gain practical exposure to water resource management and irrigation infrastructure."},{date:"25 Jul 2025",title:"Field Visit to SRS CNC Pvt Ltd",type:"Field Visit",location:"Perundurai R.S",participants:"Mechanical Students and Faculty Members",venue:"SRS CNC Pvt Ltd",outcomes:["Understand the basics of CNC machining operations.","Learn about modern manufacturing processes.","Observe the working of CNC machines and tools.","Understand quality control in production.","Gain knowledge of industrial safety practices."],industryExposure:"Gain practical exposure to CNC manufacturing processes and industrial work culture."},{date:"19 Jul 2025",title:"Field Visit to Sakthi Auto Component Limited",type:"Field Visit",location:"Pallagounden Palayam",participants:"Mechanical Students and Faculty Members",venue:"Sakthi Auto Component Limited",outcomes:["Understand the manufacturing process of auto components.","Learn about modern industrial machines and equipment.","Observe quality control and production practices.","Gain knowledge of industry working environments.","Bridge the gap between classroom learning and industry applications."],industryExposure:"Gain practical exposure to industrial operations and work culture."},{date:"09 Jul 2025",title:"Special Lecture on 'Additional Skills need in Industries for current scenario'",type:"Special Lecture",speaker:"Mr. O. Selvaraj, B.E.",designation:"Manager",organization:"JSW Steel Limited, Salem",venue:"Kalingarayan Seminar Hall",time:"10:00 A.M.",outcomes:["Apply engineering knowledge to solve problems.","Design and develop engineering solutions.","Use modern tools and technologies effectively.","Work well in teams and communicate clearly.","Follow ethics and continue lifelong learning."]}],labGallery:[{src:"/assets/departments/selected/mech Selected/MECH (1).webp",title:"Thermal Engineering Lab",desc:"Boiler and internal combustion engines testing rigs."},{src:"/assets/departments/selected/mech Selected/MECH (3).webp",title:"Lathe & Machine Shop",desc:"Precision machining and component turning on lathes."},{src:"/assets/departments/selected/mech Selected/MECH (7).webp",title:"Special Machines & Milling Lab",desc:"Shapers, slotters, and universal milling machines."},{src:"/assets/departments/selected/mech Selected/MECH (8).webp",title:"Foundry & Welding Workshop",desc:"Arc welding, gas welding, and foundry casting workstations."},{src:"/assets/departments/selected/mech Selected/MECH (9).webp",title:"Fluid Power & Hydraulics Lab",desc:"Pneumatics, hydraulic power packs, and pump test rigs."},{src:"/assets/departments/selected/mech Selected/MECH (12).webp",title:"Metrology & Measurement Lab",desc:"Precision measurement instruments, verniers, and micrometers."},{src:"/assets/departments/selected/mech Selected/MECH (13).webp",title:"CAD/CAM & Automation Lab",desc:"Modern CAD design software and CNC programming suites."},{src:"/assets/departments/selected/mech Selected/MECH (16).webp",title:"CNC Machining Center",desc:"Computer numerical control lathe and milling operations."},{src:"/assets/departments/selected/mech Selected/MECH (17).webp",title:"Automotive Systems & Engines Lab",desc:"Engine assembly, dismantling, and performance test benches."},{src:"/assets/departments/selected/mech Selected/MECH (22).webp",title:"Manufacturing Technology Workshop",desc:"Hands-on fitting, sheet metal, and fabrication training."},{src:"/assets/departments/selected/mech Selected/MECH (27).webp",title:"Advanced Manufacturing Practice",desc:"Component fabrication and tool handling stations."},{src:"/assets/departments/selected/mech Selected/DSC06245.webp",title:"Heavy Machinery & Lathe Workshop",desc:"Industrial scale turning and manufacturing facility."}],icon:(0,a.jsxs)("svg",{className:"w-6 h-6",fill:"none",stroke:"url(#dg-mech)",strokeWidth:"2",viewBox:"0 0 24 24",children:[(0,a.jsx)("defs",{children:(0,a.jsxs)("linearGradient",{id:"dg-mech",x1:"0%",y1:"0%",x2:"0%",y2:"100%",children:[(0,a.jsx)("stop",{offset:"0%",stopColor:"#91C04A"}),(0,a.jsx)("stop",{offset:"100%",stopColor:"#009EDB"})]})}),(0,a.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",d:"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"}),(0,a.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",d:"M15 12a3 3 0 11-6 0 3 3 0 016 0z"})]})},{id:"eee",slug:"eee",name:"Electrical & Electronics Engineering",fullName:"Electrical & Electronics Engineering",established:1994,intake:60,duration:"3 Years",syllabus:"/assets/departments/eee/1030 - Electrical Engg (Full Time) (1).pdf",image:"https://images.unsplash.com/photo-1581092921461-eab62e97a780?auto=format&fit=crop&w=600&q=80",slogan:"Energizing minds, illuminating the future.",description:"The Department of Electrical and Electronics Engineering (EEE) was established in 1994. The department has an annual intake of 60 students. It has been offering quality technical education in the field of Electrical and Electronics Engineering for many years.",overviewBullets:["The department provides knowledge in Electrical Engineering, Electronics, and Electromagnetism.","Students learn about: Power Generation, Power Transmission and Distribution, Electrical Motors, Generators, Transformers.","The curriculum includes basic concepts of: Electronics, Control Systems, Automation.","The department helps students develop technical and practical skills required for industry."],labs:["Electrical Machines Lab (AC & DC)","Power Electronics & Control Lab","Electrical Wiring & Simulation Lab","Renewable Energy & Solar Integration Lab"],careers:["Jobs in power generation, transmission, and distribution sectors.","Opportunities in electrical equipment manufacturing industries.","Careers in the installation and maintenance of electrical systems.","Employment in automation and control system industries.","Job opportunities in government, public sector, and private organizations.","Opportunities to work in India and abroad."],faculty:[{name:"M. Periasamy",designation:"SG1 / Dept. Head",doj:"01-02-2008",dob:"28-03-1984",qualification:"M.E., MISTE.,",experience:"18 Years 4 Months",phone:"9942922005",image:"/assets/departments/Faculty/TEACHING kpc/EEE/periyasamy.webp"},{name:"G. Chandran",designation:"SG1 Lecturer",doj:"10-12-2010",dob:"15-12-1987",qualification:"M.E., MISTE.,",experience:"15 Years 6 Months",phone:"9942596413",image:"/assets/departments/Faculty/TEACHING kpc/EEE/chandran.webp"},{name:"N. Govindaraj",designation:"Sr. Lecturer",doj:"18-07-2011",dob:"17-06-1987",qualification:"B.E., MISTE.,",experience:"14 Years 11 Months",phone:"9976088981",image:"/assets/departments/Faculty/TEACHING kpc/EEE/govindharaj.webp"},{name:"S. Mohanraj",designation:"Lecturer",doj:"01-12-2016",dob:"25-01-1989",qualification:"B.E., MISTE.,",experience:"9 Years 6 Months",phone:"9500450673",image:"/assets/departments/Faculty/TEACHING kpc/EEE/mohanraj.webp"},{name:"S. Murugaraj",designation:"Lecturer",doj:"07-12-2020",dob:"14-11-1987",qualification:"B.E.,",experience:"5 Years 6 Months",phone:"9942804893",image:"/assets/departments/Faculty/TEACHING kpc/EEE/murugaraj.webp"},{name:"S. Gobinath",designation:"Sr. Workshop Instructor",doj:"21-07-2009",dob:"11-11-1989",qualification:"D.E.C.E.,",experience:"16 Years 10 Months",phone:"9688748861",image:"/assets/departments/Faculty/NONTEACHING kpc/EEE/gobi.webp"},{name:"D. Praveen Kumar",designation:"Lab Assistant",doj:"18-11-2021",dob:"24-05-1997",qualification:"D.E.E.E.,",experience:"4 Years 7 Months",phone:"8675944630",image:"/assets/departments/Faculty/NONTEACHING kpc/EEE/praveen.webp"},{name:"P.K. Jeevanantham",designation:"Lab Assistant",doj:"24-07-2025",dob:"15-05-1982",qualification:"ITI",experience:"0 Years 10 Months",phone:"9750823765",image:"/assets/departments/Faculty/NONTEACHING kpc/EEE/jeeva.webp"}],alumni:[{name:"Navaneetha Kasavan V",batch:"2012 – 2015 Batch",salary:"8 Lakh/Annum",position:"Sr. Engineer",company:"Southern Petrochemical Industries Corporation Ltd. (SPIC)",location:"Thoothukudi",image:"/assets/departments/EEE/Navaneetha Kasavan V.webp"},{name:"Maivel M",batch:"2010 – 2012 Batch",salary:"10 Lakh/Annum",position:"Manager, EV System",company:"TVS Motor",location:"Hosur",image:"/assets/departments/EEE/Maivel M.webp"},{name:"Kishore G",batch:"2018 - 2021 Batch",salary:"4.8 Lakh/Annum",position:"Junior Engineer",company:"VA Tech Wabag",location:"Chennai",image:"/assets/departments/EEE/Kishore G.webp"},{name:"Siva K",batch:"2018 - 2021 Batch",salary:"6 Lakh/Annum",position:"Electrical Maintenance, Executive",company:"Dalmia Bharat Cement Ltd",location:"Lalgudi, Tamil Nadu",image:"/assets/departments/EEE/Siva K.webp"},{name:"Manoj Kumar R",batch:"2014 - 2017 Batch",salary:"7.5 Lakh/Annum",position:"Associate Lead",company:"Titan Engineering & Automation Limited",location:"Hosur, Tamil Nadu",image:"/assets/departments/EEE/Manoj Kumar R.webp"}],keyStrengths:["Experienced faculty members.","Well-equipped laboratories.","Industry-oriented learning.","Focus on practical knowledge and skill development.","Good career opportunities in the electrical and electronics field."],hodMessage:"Welcome to the Department of Electrical and Electronics Engineering. Our department is committed to providing quality education, technical knowledge, and practical skills that will help you succeed in your academic and professional careers. I encourage every student to actively participate in workshops, seminars, projects, internships, and co-curricular activities to enhance their learning experience. Develop a strong foundation in engineering principles, cultivate innovative thinking, and maintain a spirit of continuous learning. With dedication, discipline, and hard work, you can become competent engineers and responsible citizens who contribute positively to society and the nation.",achievements:[{year:"2026",title:"TECH BLITZ-2K26 Paper Presentation Prize",desc:"G. Kanaga Mani Maran (II EEE) secured First Prize and received a cash award of ₹1,500 at Shree Venkateshwara Polytechnic College."},{year:"2026",title:"Nandha's Innovation Day '26 Project Exhibition Prize",desc:"T. Dinesh and S. Sri Harish (III EEE) successfully developed 'Solar Wireless Electrical Car Charging' and secured First Prize with a cash award of ₹1,000."},{year:"2025",title:"IoT Based Water Flow Meter Exhibition",desc:"Murali Prasanth N, Satheeshkumar T, and Kamalesh R developed the mini project 'IoT Based Water Flow Meter and Emergency System' exhibited during the College Expo."},{year:"2025",title:"Solar Wireless Electrical Car Charging Development",desc:"Dinesh T, Subash T, and Dharanesh D successfully developed 'Solar Wireless Electrical Car Charging' mini project exhibited at the College Expo."}],achievementGallery:[{src:"/assets/departments/EEE/Nandha’s Innovation Day ’26.webp",title:"Paper Presentation Prize",desc:"G. Kanaga Mani Maran (II EEE) securing First Prize at Shree Venkateshwara Polytechnic College."},{src:"/assets/departments/EEE/Solar Wireless Electrical Car Charging.webp",title:"Project Exhibition Prize",desc:"T. Dinesh and S. Sri Harish (III EEE) securing First Prize on Nandha's Innovation Day '26."},{src:"/assets/departments/EEE/IoT Based Water Flow Meter and Emergency System.webp",title:"IoT Project Expo",desc:"EEE students exhibiting the IoT Based Water Flow Meter at the College Expo."}],events:[{date:"25 Feb 2026",title:"Guest Lecture on 'Industrial Automation'",type:"Guest Lecture",speaker:"Mr. V. Ramesh",designation:"Assistant General Manager – Co-Gen. Electrical (Head Power Plant)",organization:"Sakthi Sugars Limited, Sakthi Nagar",venue:"Dheeran Chinnamalai Seminar Hall",time:"10:30 A.M.",outcomes:["Understand the fundamentals and significance of industrial automation in modern industries.","Gain knowledge of automation components such as sensors, actuators, PLCs, and SCADA systems.","Explore the role of automation in improving productivity, efficiency, and safety.","Learn about automation practices adopted in power plants and process industries.","Develop awareness of emerging trends and career opportunities in industrial automation."]},{date:"23 Dec 2025",title:"Field Visit to 1 MW Solar Power Plant",type:"Field Visit",location:"KVIT Trust, SIPCOT, Perundurai",participants:"EEE Students and Faculty Members",venue:"KVIT Trust, SIPCOT, Perundurai",outcomes:["Understand the working principles of solar photovoltaic (PV) systems.","Gain practical knowledge of solar power plant components, including PV modules, inverters, transformers, and control systems.","Learn about power generation, monitoring, and maintenance procedures in a utility-scale solar plant.","Understand grid integration and energy management techniques used in solar power generation.","Develop awareness of renewable energy technologies and career opportunities in the green energy sector.","Bridge the gap between theoretical concepts and industrial practices through hands-on observation."],industryExposure:"Renewable Energy and Solar Power Generation Technologies."},{date:"18 Sep 2025",title:"Guest Lecture on 'Diesel Generator’s Operation & Maintenance'",type:"Guest Lecture",speaker:"Mr. R. G. Balaji, M.E.",designation:"Business Development Executive",organization:"Erode Power Sales Corporation, Erode",venue:"Dheeran Chinnamalai Seminar Hall",time:"10:30 A.M.",outcomes:["Understand the construction and working principles of diesel generators.","Gain knowledge of diesel generator operation, control systems, and performance monitoring.","Learn preventive and corrective maintenance practices for reliable generator performance.","Identify common faults and troubleshooting techniques in diesel generator systems.","Develop awareness of safety procedures and industry standards related to generator operation and maintenance."]},{date:"18 Jul 2025",title:"Special Lecture on 'Home Technologies'",type:"Special Lecture",speaker:"Mr. P. R. Srenivasan, DECE",designation:"Managing Director, Mark Technologies & Cinespa Private Limited, Coimbatore",venue:"Kalingarayan Seminar Hall",time:"10:30 A.M.",outcomes:["Understand the fundamentals and emerging trends in home technologies.","Gain knowledge of smart home systems and automation concepts.","Explore the applications of modern technologies in residential environments.","Recognize the role of electronics and communication technologies in enhancing home safety, comfort, and energy efficiency.","Develop awareness of career opportunities and innovations in the field of home technology."]}],ivGallery:[{src:"/assets/departments/EEE/Inaugural function.webp",title:"Special Lecture on 'Home Technologies'",desc:"Guest lecture on smart home automation and technologies."},{src:"/assets/departments/EEE/Guest Lecture.webp",title:"Guest Lecture on 'Diesel Generator’s Operation & Maintenance'",desc:"Session on working and maintenance of diesel generators."},{src:"/assets/departments/EEE/FIELD VISIT.webp",title:"Field Visit to 1 MW Solar Power Plant",desc:"EEE students at the solar power plant, SIPCOT."},{src:"/assets/departments/EEE/Valedictory function.webp",title:"Guest Lecture on 'Industrial Automation'",desc:"Guest lecture on PLC, SCADA, and modern automation."}],labGallery:[{src:"/assets/departments/selected/EEE/EEE (1).webp",title:"Electrical Machines Laboratory",desc:"AC/DC motors, generators, and transformer test benches."},{src:"/assets/departments/selected/EEE/EEE (2).webp",title:"Power Electronics & Drives Lab",desc:"Thyristors, inverters, and speed control circuits."},{src:"/assets/departments/selected/EEE/EEE (3).webp",title:"Control Systems & PLC Automation Lab",desc:"Programmable Logic Controllers and sensor interfaces."},{src:"/assets/departments/selected/EEE/EEE (4).webp",title:"Measurements & Instrumentation Lab",desc:"Oscilloscopes, multimeters, and calibration equipment."},{src:"/assets/departments/selected/EEE/EEE (5).webp",title:"Electrical Wiring & Power Systems Lab",desc:"Domestic and industrial wiring panels with safety circuit breakers."}],icon:(0,a.jsxs)("svg",{className:"w-6 h-6",fill:"none",stroke:"url(#dg-eee)",strokeWidth:"2",viewBox:"0 0 24 24",children:[(0,a.jsx)("defs",{children:(0,a.jsxs)("linearGradient",{id:"dg-eee",x1:"0%",y1:"0%",x2:"0%",y2:"100%",children:[(0,a.jsx)("stop",{offset:"0%",stopColor:"#91C04A"}),(0,a.jsx)("stop",{offset:"100%",stopColor:"#009EDB"})]})}),(0,a.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",d:"M13 10V3L4 14h7v7l9-11h-7z"})]})},{id:"ece",slug:"ece",name:"Electronics & Communication Engineering",fullName:"Electronics & Communication Engineering",established:1985,intake:60,duration:"3 Years",syllabus:"/assets/departments/ECE/1040 ECE Full time.pdf",image:"https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=80",slogan:"Connecting the world, engineering intelligence.",description:"The Department of Electronics and Communication Engineering (ECE) was established in 1985. The department has an annual intake of 60 students. It has been offering quality technical education in the field of Electronics and Communication Engineering for many years. It emphasizes practical, component-level lab work and industry-oriented training, with placement support into telecom, automation, consumer electronics, and government sectors.",overviewBullets:["It’s a 3 years full-time program approved by AICTE.","The department provides knowledge in Electronics and Communication.","The department trains students in the Design, Testing, and Maintenance of electronic circuits, communication systems, and networks.","The curriculum includes basic concepts of: Electronics, Communication, Networks.","The department helps students develop technical and practical skills required for industry."],labs:["Electronic Devices & Circuit Lab","Digital Electronics Lab","PCB Design Lab","Communication Lab (Analog, Digital, Microwave & Fiber Optics)","Microcontroller Lab","Computer Hardware & Networking Lab","Embedded System Lab","VLSI Lab"],careers:["Telecom and broadcasting","Robotics and automation","Consumer Electronics","Healthcare equipment manufacturing","Government sectors like ISRO, DRDO, BEL, BSNL, and MNCs like Wipro, Dell, ABB."],learningBeyond:["Emphasis on both fundamental and advanced technologies in ECE.","Paper presentation and seminars to build communication and interpersonal skills.","Exposure to component level lab work and practical projects."],keyStrengths:["Experienced faculty members.","Well-equipped laboratories.","Industry-oriented learning.","Focus on practical knowledge and skill development.","Good career opportunities in the electronics and communication field."],hodMessage:"Electronics and Communication is at the core of every smart device, communication network, and automation system that shapes our world today. Our department focuses on building strong technical fundamental while giving students ample hands-on experience through modern labs, industrial visits, mini-projects, and competitions like hackathons. With dedicated faculty support, industry interaction, and a culture of innovation, we prepare our students for successful careers and higher studies. I welcome you to be part of our journey in creating the next generation of electronics professionals.",faculty:[{name:"S. Karthikeyan",designation:"HOD I/C",doj:"01-12-2009",dob:"05.07.1985",qualification:"M.E.,",experience:"17 Years 6 Months",phone:"9944181808",image:"/assets/departments/Faculty/TEACHING kpc/ECE/karthikeyan.webp"},{name:"N. R. Sivakumar",designation:"SG1.Lect",doj:"12-06-2002",dob:"10.04.1970",qualification:"M.E.,",experience:"25 Years 0 Months",phone:"9965995484",image:"/assets/departments/Faculty/TEACHING kpc/ECE/sivakumar.webp"},{name:"V. Loganathan",designation:"Sr.Lecturer",doj:"01-06-2016",dob:"11.05.1986",qualification:"M.E.,",experience:"18 Years 0 Months",phone:"9944914858",image:"/assets/departments/Faculty/TEACHING kpc/ECE/loganathan.webp"},{name:"T. R. Rajalakshmi",designation:"Lecturer",doj:"01-12-2023",dob:"09.06.1992",qualification:"M.E.,",experience:"2 Years 5 Months",phone:"7667146720",image:"/assets/departments/Faculty/TEACHING kpc/ECE/rajalakshmi.webp"},{name:"E. Kiruthika",designation:"Lecturer",doj:"28-09-2026",dob:"15.07.2004",qualification:"B.E., (ECE)",experience:"0 Years 0 Months",phone:"9360028745",image:"/assets/departments/Faculty/TEACHING kpc/ECE/kiruthika.webp"},{name:"K. Nachimuthu",designation:"Instructor",doj:"21-11-1995",dob:"30.09.1970",qualification:"ITI",experience:"30 Years 5 Months",phone:"8754966226",image:"/assets/departments/Faculty/NONTEACHING kpc/ECE/nachimuthu.webp"},{name:"A. Vijayakumar",designation:"Sr.Instructor",doj:"07-11-2001",dob:"10.04.1971",qualification:"B.E.,",experience:"25 Years 5 Months",phone:"9965128189",image:"/assets/departments/Faculty/NONTEACHING kpc/ECE/vijayakumar.webp"},{name:"G. Geetha",designation:"Lab Asst",doj:"01-11-2025",dob:"01.11.1985",qualification:"B.SC(CDF)",experience:"0 Years 7 Months",phone:"9965581038",image:"/assets/departments/Faculty/NONTEACHING kpc/ECE/geetha.webp"}],alumni:[{name:"Bharanidharan Murugesan",batch:"2020 – 2023 Batch",salary:"7.5 Lakh/Annum",position:"Lab Engineer",company:"Texas Instruments India",location:"Bangalore",image:"/assets/departments/ECE/Bharanidharan.webp"},{name:"Devanand R",batch:"2020 – 2023 Batch",salary:"7.5 Lakh/Annum",position:"Associate Instrumentation Designer Engineer",company:"J Ray Mc Dermott Engineering Services Pvt Ltd",location:"Chennai",image:"/assets/departments/ECE/Devavand R.webp"},{name:"Sri Revanth P",batch:"2018 – 2021 Batch",salary:"5.2 Lakh/Annum",position:"Associate Process Engineer",company:"Flextronics Technologies India Pvt Ltd",location:"Coimbatore",image:"/assets/departments/ECE/Sri Revanth.webp"},{name:"Rohith B",batch:"2018 – 2021 Batch",salary:"6 Lakh/Annum",position:"Procurement Executive",company:"G3 Renewables",location:"Kochi",image:"/assets/departments/ECE/Rohith B.webp"},{name:"Praveen N",batch:"2018 – 2021 Batch",salary:"4.5 Lakh/Annum",position:"Develop Engineer",company:"Zibtek",location:"Bangalore",image:"/assets/departments/ECE/Praveen N.webp"}],achievements:[{year:"2026",title:"External Hackathon - III Prize",desc:"M. Sonigasri, K. Hruthika, and K. Dakshada secured third place in the External Hackathon for 'Automatic Street Light' organized by PSG Coimbatore, receiving a cash award of ₹1,500.",images:["/assets/departments/ECE/Dakshada.webp"]},{year:"2025",title:"Paper Presentations - Multiple Prizes",desc:"Students won top prizes at other colleges: Tharani K & Sri Garna Prabanth G S won 1st Place at Sakthi Polytechnic College; Sakthi Swetha U S won 2nd Place at Shree Venkateshwara Hi-Tech and Sakthi Polytechnic; Kavikumaran R & Sridhar M won 2nd Place at Sakthi Polytechnic.",images:["/assets/departments/ECE/Tharani K.webp","/assets/departments/ECE/Sri Garna Prabanth.webp","/assets/departments/ECE/Sakthi Swetha.webp","/assets/departments/ECE/Kavikumaran R.webp","/assets/departments/ECE/Sridhar M.webp"]},{year:"2025",title:"Sports Activities - Top Honors",desc:"Naresh V secured State 2nd Place in 400x400m and Division 1st Place in 5000m & 400x400m. Abisheik P secured Division 2nd in 110m. Dakshada K secured Division 3rd in Table Tennis. Sanmathi N secured Division 2nd in Volleyball and Suhashini R won Division 2nd in High Jump.",images:["/assets/departments/ECE/Naresh V.webp","/assets/departments/ECE/Abishek P.webp","/assets/departments/ECE/Dakshada.webp","/assets/departments/ECE/Sanmathi.webp","/assets/departments/ECE/Suhashini R.webp"]}],ivGallery:[{src:"/assets/departments/ECE/Inaugural function.webp",title:"Special Lecture",desc:"Special lecture session with guest speakers."},{src:"/assets/departments/ECE/External hackathon.webp",title:"Smart Irrigation Systems",desc:"Guest lecture on smart irrigation systems using wireless networks."},{src:"/assets/departments/ECE/FIELD VISIT.webp",title:"Benchmark Tea Exploratorium",desc:"Industrial field visit to Benchmark Tea Exploratorium in Ooty."},{src:"/assets/departments/ECE/Field Visit to  NUCLEAR POWER PLANT.webp",title:"Nuclear Power Plant Visit",desc:"Field visit to Kudankulam Nuclear Power Plant."},{src:"/assets/departments/ECE/Anti-Ragging awareness.webp",title:"Awareness Campaign",desc:"Anti-Ragging awareness video production and campaign."},{src:"/assets/departments/ECE/Valedictory function.webp",title:"Electronics Symposium",desc:"Students presenting engineering projects at the symposium."}],events:[{date:"10 Sep 2026",title:"Guest Lecture on '5G Technology in Mobile Communication'",type:"Guest Lecture",speaker:"Mr. M. Dhanasekar, B.E., M.B.A.",designation:"Senior Manager - Deployment",organization:"Reliance Industries Ltd (JIO), Coimbatore",desc:"On behalf of the Department of Electronics and Communication Engineering Association, Kongu Polytechnic College conducted a Guest Lecture on the topic '5G Technology in Mobile Communication' on 10.09.2026. The lecture was delivered by Mr. M. Dhanasekar, B.E., M.B.A., Senior Manager - Deployment, Reliance Industries Ltd (JIO), Coimbatore. He explained the evolution from 1G to 5G, 5G architecture, network slicing, applications of 5G in IoT, Industry 4.0, and future career opportunities for Diploma students in the Telecom sector. Students interacted enthusiastically and clarified their doubts.",outcomes:["Understand the evolution of wireless technologies from 1G to 5G networks.","Gain knowledge of 5G architecture, core network infrastructure, and network slicing.","Explore real-world applications of 5G in IoT, smart devices, and Industry 4.0.","Discover future career pathways and industry skill requirements in the telecom sector."],industryExposure:"Direct deployment perspectives and industry standards from Reliance Industries Ltd (JIO)."},{date:"14 Aug 2026",title:"Industrial Visit to Vikram Sarabhai Space Centre (VSSC) - ISRO",type:"Industrial Visit",location:"Thumba, Thiruvananthapuram, Kerala",venue:"Vikram Sarabhai Space Centre (VSSC)",participants:"107 Students (III & V Semester ECE) and 8 Staff Members",desc:"The Department of Electronics & Communication Engineering, Kongu Polytechnic College, Perundurai organized an Industrial Visit to Vikram Sarabhai Space Centre (VSSC), Thiruvananthapuram on 14.08.2026. A total of 107 students from III & V Semester ECE along with 08 staff members visited VSSC as per the permission received from the Public Relations Officer, VSSC. VSSC is the lead centre of ISRO for design and development of Launch Vehicle Technology (SLV, ASLV, PSLV, GSLV, LVM3, SSLV, RLV, and Gaganyaan). This visit provided students with valuable exposure to Space Technology, Satellite Communication, Launch Vehicle Systems, and ISRO's research activities, enhancing their practical knowledge beyond the curriculum.",outcomes:["Gain direct exposure to Space Technology, satellite communication, and ISRO's launch vehicles.","Understand the design and development of launch systems including PSLV, GSLV, LVM3, SSLV, and RLV.","Learn about advanced avionics, telemetry, and tracking systems in space missions like Gaganyaan.","Broaden practical understanding of aerospace electronics, rocketry, and space research."],industryExposure:"Direct visit and scientific interaction at India's premier space research centre (ISRO - VSSC)."},{date:"25 Feb 2026",title:"Guest Lecture on 'Role of Electronics in Smart Irrigation Systems'",type:"Guest Lecture",speaker:"Mr. K. Dhevendhiran",designation:"HR Manager",organization:"Mobitech Wireless Solutions Pvt Ltd",venue:"Dheeran Chinnamalai Seminar Hall",time:"02:00 P.M.",outcomes:["Students can design and interface sensors like soil moisture, temperature and humidity sensors with microcontroller such as Arduino.","Students can develop embedded systems to automate irrigation pumps and water flow based on sensor programmed thresholds reducing water wastage.","Students can implement wireless communication using WI-FI to transmit sensor data to cloud or mobile apps for monitoring and control.","Students can design low-power circuits.","Students can explain how electronics-driven smart irrigation conserves water, improves crop yield and supports precision agriculture and sustainable farming."]},{date:"Oct 2025",title:"Anti-Ragging Awareness Video Production",type:"Awareness Campaign",venue:"Campus",time:"N/A",outcomes:["Students understand their role in maintaining a safe campus environment.","Apply technical and creative skills to deliver a strong social message.","Collaborate on scripting, shooting and editing to produce a professional awareness tool.","Take initiative to drive positive cultural change within the institution."]},{date:"04 Sep 2025",title:"Field Visit to Benchmark Tea Exploratorium",type:"Field Visit",location:"Ooty",participants:"II-ECE Students and Faculty Members",venue:"Benchmark Tea Exploratorium, Ooty",outcomes:["Understand the concepts in electronics, instrumentation and manufacturing with actual industrial process and equipment.","Observe workplace safety, discipline, teamwork and professional conduct followed in industry environment.","Gain awareness of modern machinery automation systems, PLCs, control panels and quality testing methods used in industry.","Learn about job roles skill requirements and career paths available in core electronics manufacturing and allied industries.","Understand quality control, ISO standards and environmental safety regulations followed by industries."]},{date:"25 Aug 2025",title:"Field Visit to Kudankulam Nuclear Power Plant",type:"Field Visit",location:"Kudankulam",participants:"III-ECE Students and Faculty Members",venue:"Nuclear Power Plant, Kudankulam",outcomes:["Explain the basic principles of nuclear fission, reactor types and the role of control rods, coolant systems and turbines in power generation.","Recognize safety protocols, radiation measures and emergency systems used in nuclear facilities to ensure public and worker safety.","Observe how sensors control systems and automation are used to monitor reactor parameters like temperature, pressure and radiation levels.","Identify the role of electronics, PLCs and communication systems.","Gain industry etiquette and awareness of career opportunities in NPCIL."]},{date:"18 Jul 2025",title:"Special Lecture on 'Home Technologies'",type:"Special Lecture",speaker:"Mr. P. R. Srinivasan, DECE",designation:"Managing Director",organization:"Mark Technologies & Cinespa Private Limited, Coimbatore",venue:"Kalingarayan Seminar Hall",time:"10:30 A.M.",outcomes:["Understand the fundamentals and emerging trends in home technologies.","Gain knowledge of smart home systems and automation concepts.","Explore the applications of modern technologies in residential environments.","Recognize the role of electronics and communication technologies in enhancing home safety, comfort, and energy efficiency.","Develop awareness of career opportunities and innovations in the field of home technology."]}],placements:[{rollNo:"23DEC020",name:"R J Karunaashankar",image:"/assets/departments/ECE/Karunaashankar.webp",offers:[{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DEC019",name:"M S Kanishk Karthi",image:"/assets/departments/ECE/Kanishkkarthi.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"}]},{rollNo:"23DEC005",name:"D Divakar",image:"/assets/departments/ECE/Divakar D.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"},{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"}]},{rollNo:"23DEC014",name:"R Hari Krishnan",image:"/assets/departments/ECE/Hari KrishnaN R.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"}]},{rollNo:"23DEC027",name:"P Mohanraj",image:"/assets/departments/ECE/MohanRaj P.webp",offers:[{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DEC062",name:"S Gnanasekar",image:"/assets/departments/ECE/Gnanasekar S.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"}]},{rollNo:"23DEC011",name:"B Gowthaman",image:"/assets/departments/ECE/Gowthaman B.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"},{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"}]},{rollNo:"23DEC034",name:"R Praneshraj",image:"/assets/departments/ECE/Praneshraj R.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"Montra Electric (EV), Chennai",salary:"2.72 LPA"}]},{rollNo:"23DEC031",name:"K Naveen Kumar",image:"/assets/departments/ECE/Naveen Kumar K.webp",offers:[{company:"Montra Electric (EV), Chennai",salary:"2.72 LPA"},{company:"Royal Enfield, Chennai",salary:"2.58 LPA"}]},{rollNo:"23DEC064",name:"A Mohamed Sabir",image:"/assets/departments/ECE/A Mohamed Sabir.webp",offers:[{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"}]},{rollNo:"23DEC052",name:"D Venuprasath",image:"/assets/departments/ECE/Venuprasath D.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"}]},{rollNo:"23DEC035",name:"J R Ranesh",image:"/assets/departments/ECE/J R Ranesh.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DEC047",name:"C Selvaprasath",image:"/assets/departments/ECE/Selvaprasath C.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"}]},{rollNo:"23DEC038",name:"E M Rithikkanna",image:"/assets/departments/ECE/Rithikkanna E M.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"}]},{rollNo:"23DEC061",name:"N Dhayanithi",image:"/assets/departments/ECE/Dhayanithi N.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"}]},{rollNo:"23DEC004",name:"K Dhanish",image:"/assets/departments/ECE/Dhanish K.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"},{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"}]},{rollNo:"23DEC013",name:"S Guhan",image:"/assets/departments/ECE/Guhan S.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"Brakes India Private Limited, Chennai",salary:"2.28 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"},{company:"Hyundai Motors Private Limited, Chennai",salary:"2.64 LPA"}]},{rollNo:"23DEC023",name:"R Kavya",image:"/assets/departments/ECE/Kavya R.webp",offers:[{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DEC056",name:"B Harishini",image:"/assets/departments/ECE/Harshini B.webp",offers:[{company:"Montra Electric (EV), Chennai",salary:"2.72 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DEC050",name:"R Suhashini",image:"/assets/departments/ECE/Suhashini R.webp",offers:[{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]}],labGallery:[{src:"/assets/departments/selected/Selected ECE/ECE (1).webp",title:"Electronic Devices & Circuits Lab",desc:"Semiconductor component characterization and waveform testing."},{src:"/assets/departments/selected/Selected ECE/ECE (4).webp",title:"Microcontroller & Embedded Systems Lab",desc:"ARM, 8051, Arduino, and embedded programming boards."},{src:"/assets/departments/selected/Selected ECE/ECE-2 (1).webp",title:"VLSI Design & Simulation Center",desc:"Digital circuit simulation and FPGA development kits."},{src:"/assets/departments/selected/Selected ECE/ECE-2 (4).webp",title:"Communication Engineering Lab",desc:"RF, modulation systems, and optical communication kits."},{src:"/assets/departments/selected/Selected ECE/ECE-2 (5).webp",title:"Linear Integrated Circuits Lab",desc:"Op-amp applications, filters, and timer circuits."}],icon:(0,a.jsxs)("svg",{className:"w-6 h-6",fill:"none",stroke:"url(#dg-ece)",strokeWidth:"2",viewBox:"0 0 24 24",children:[(0,a.jsx)("defs",{children:(0,a.jsxs)("linearGradient",{id:"dg-ece",x1:"0%",y1:"0%",x2:"0%",y2:"100%",children:[(0,a.jsx)("stop",{offset:"0%",stopColor:"#91C04A"}),(0,a.jsx)("stop",{offset:"100%",stopColor:"#009EDB"})]})}),(0,a.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",d:"M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"})]})},{id:"cse",slug:"cse",name:"Computer Engineering",fullName:"Computer Engineering",established:1988,intake:60,duration:"3 Years",syllabus:"/assets/departments/CSE/Final Copy 1052 Computer Engineering Full time.pdf",image:"https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=600&q=80",slogan:"Decoding challenges, coding the future.",description:"The Department of Computer Engineering, established in 1988, has been a pioneer in delivering quality technical education for over three decades. The department is committed to nurturing competent professionals with strong foundations in both software development and Computer Hardware technologies.",overviewBullets:["Over the decades, the Department of Computer Engineering has consistently produced skilled diploma engineers who have achieved remarkable success in academics, higher education all over India, entrepreneurship, and the IT industry.","The department has a proud tradition of securing State Top Rank Holders and achieving Excellent pass percentages, with the majority of students successfully completing their diploma programme every year with high CGPA.","Comprehensive Learning: Specialized training in Software Engineering, Computer Hardware, Networking, Programming, and Emerging Technologies such as Artificial Intelligence, Full Stack Developer, and IoT.","Industry-Focused Education: Emphasis on practical skills, innovation, and employability."],coreAreas:["Operating Systems","Web Designing and Web Development","Internet of Things (IoT)","Computer Networks & Security","Cloud Computing","Data Structures and Algorithms","Software Engineering and Programming Concepts","Programming Languages – C, C++, Java, Python, and more","Artificial Intelligence and Intelligent Systems","Computer Hardware and System Maintenance","Digital Electronics & Circuits","Multimedia Design and Creative Technologies"],learningBeyond:["Mini and Major Projects","Industry Visits and Internships","Value-Added Certification Courses","Industry-Institute Interaction Programmes"],skillDevelopment:["Problem-Solving Skills","Programming and Software Development Skills","Hardware Troubleshooting Skills","Communication and Teamwork Skills","Innovation and Entrepreneurial Mindset","Industry-Ready Technical Competencies"],labs:["Software Engineering & Java Coding Lab","Database Management & Web Tech Lab","Cyber Security & Cloud Systems Lab","Mobile Application & AI Tools Lab"],careers:["Software & IT Companies","Multimedia & Design","Hardware & Networking","Cloud Computing & Data Centre","Global Opportunities"],keyStrengths:["Academic Excellence","Skilled and Supportive Faculty","Industry-Relevant Training","Strong Technical Foundation","Enhanced Employability Skills"],hodMessage:"Welcome to the Department of Computer Engineering. The Department of Computer Engineering, established in 1988, is dedicated to providing quality technical education and developing skilled professionals for the IT industry. Our department offers a strong foundation in Software, Hardware, Networking, Artificial Intelligence, Cloud Computing, and other emerging technologies. We focus on both theoretical knowledge and practical learning through well-equipped laboratories, projects, workshops, industrial visits, and value-added courses. Our experienced faculty members guide students to enhance their technical skills, problem-solving abilities, and professional ethics. We are proud of our students' achievements, including university rank holders, excellent academic performance, successful placements, and higher education pursuits. Our aim is to prepare students to meet industry requirements and become responsible technology professionals. I encourage every student to make the best use of the opportunities provided by the department and strive for excellence in their academic and professional careers. Wishing you a bright and successful future.",faculty:[{name:"Dhanasekar P S",designation:"SG1 Head of Department",doj:"25-05-2007",dob:"17-10-1982",qualification:"M.E.,",experience:"19 Years 0 Months",phone:"9865657172",image:"/assets/departments/Faculty/TEACHING kpc/CT/dhanasekar.webp"},{name:"Anand Babu P",designation:"Sr. Lecturer",doj:"01-06-2007",dob:"20-03-1981",qualification:"B.E.,",experience:"19 Years 0 Months",phone:"9942577207",image:"/assets/departments/Faculty/TEACHING kpc/CT/anand babu.webp"},{name:"Murugesan R",designation:"Lecturer",doj:"23-03-2022",dob:"27-05-1989",qualification:"M.E.,",experience:"4 Years 2 Months",phone:"9952322296",image:"/assets/departments/Faculty/TEACHING kpc/CT/murugesan R.webp"},{name:"Gowtham P",designation:"Lecturer",doj:"20-07-2022",dob:"21-10-1994",qualification:"B.E.,",experience:"3 Years 10 Months",phone:"7373366227",image:"/assets/departments/Faculty/TEACHING kpc/CT/gowtham.webp"},{name:"Sownthiri K",designation:"Lecturer",doj:"10-08-2022",dob:"01-06-1988",qualification:"B.E.,",experience:"3 Years 10 Months",phone:"9944488442",image:"/assets/departments/Faculty/TEACHING kpc/CT/sownthiri.webp"},{name:"Kathirvel T",designation:"Sr.System Admin",doj:"11-09-1996",dob:"25-05-1979",qualification:"M.Com.,",experience:"29 Years 8 Months",phone:"9750460465",image:"/assets/departments/Faculty/NONTEACHING kpc/CT/kathirvel.webp"}],alumni:[{name:"Vimalan U",batch:"2019 - 2022 Batch",salary:"Not Disclosed",position:"Business Analyst",company:"Conserve Solutions",location:"Trichy",image:"/assets/departments/CSE/Vimalan U.webp"},{name:"Suganth Krishna E",batch:"2019 - 2022 Batch",salary:"Not Disclosed",position:"Product Specialist",company:"Swin Technologies",location:"Coimbatore",image:"/assets/departments/CSE/Suganth Krishna E.webp"},{name:"Yuvapriya S",batch:"2018 - 2021 Batch",salary:"Not Disclosed",position:"AI/ML Engineer",company:"Stackly Pvt. Ltd.",location:"Chennai - Remote",image:"/assets/departments/CSE/Yuvapriya S.webp"},{name:"A. Dineshkumar",batch:"2012 - 2015 Batch",salary:"Not Disclosed",position:"Senior Mobile App Developer",company:"Cblaze Info Tech Pvt. Ltd.",location:"Chennai",image:"/assets/departments/CSE/Dineshkumar A.webp"},{name:"Arun Kumar M",batch:"2011 - 2014 Batch",salary:"Not Disclosed",position:"Managing Director",company:"Mahe Software Solutions",location:"Erode",image:"/assets/departments/CSE/Arun Kumar M.webp"},{name:"Arulpriya G",batch:"2014 - 2017 Batch",salary:"Not Disclosed",position:"Senior Test Engineer",company:"KAAR Infotech Private Limited",location:"Coimbatore",image:"/assets/departments/CSE/Arulpriya G.webp"},{name:"Deepa T",batch:"2005 - 2008 Batch",salary:"Not Disclosed",position:"Sr. Associate",company:"Cognizant",location:"Bangalore",image:"/assets/departments/CSE/Deepa T.webp"},{name:"Chandrasekar G.",batch:"1989 - 1992 Batch",salary:"Not Disclosed",position:"Senior Consultant / Business Relationship Manager",company:"TCS UK / Deutsche Bank",location:"London",image:"/assets/departments/CSE/Chandrasekar G.webp"},{name:"P. R. Srenivasan",batch:"1987 - 1990 Batch",salary:"Not Disclosed",position:"Managing Direct