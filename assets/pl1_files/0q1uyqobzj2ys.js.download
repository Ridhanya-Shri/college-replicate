, Chennai",salary:"2.46 LPA"},{company:"Royal Enfield, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DCH014",name:"Dhatchanamoorthi P",image:"/assets/departments/CHEM/Dhatchanamoorthi P.webp",offers:[{company:"Arjuna Naturals, Coimbatore",salary:"3.25 LPA"},{company:"Hyundai, Chennai",salary:"2.64 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"},{company:"Royal Enfield, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DCH015",name:"Giri S",image:"/assets/departments/CHEM/Giri S.webp",offers:[{company:"Arjuna Naturals, Coimbatore",salary:"3.25 LPA"},{company:"Hyundai, Chennai",salary:"2.64 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"},{company:"Royal Enfield, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DCH016",name:"Thilak Vijay N S",image:"/assets/departments/CHEM/Thilak Vijay N S.webp",offers:[{company:"Hyundai, Chennai",salary:"2.64 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"},{company:"Royal Enfield, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DCH017",name:"Kiran C",image:"/assets/departments/CHEM/Kiran C.webp",offers:[{company:"Arjuna Naturals, Coimbatore",salary:"3.25 LPA"},{company:"Hyundai, Chennai",salary:"2.64 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"},{company:"Royal Enfield, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DCH018",name:"Guna K",image:"/assets/departments/CHEM/Guna K.webp",offers:[{company:"Hyundai, Chennai",salary:"2.64 LPA"}]}],achievements:[{year:"2025 - 2026",title:"Outstanding Sports Achievements",desc:"Chemical engineering students secured outstanding honors in state and divisional sports events: Thilak Vijay won State 1st in Chess and State 3rd in Basketball; Kiruthika C secured Divisional 1st in High Jump and Relay 4x100m, and State 4th in 4x100m Relay; Suhail P Nizar & Muhammed Aju Anan secured State 2nd in Football; Alen Joseph N B won Divisional 1st in 400m Hurdles and 4x100m Relay; Aneesh M won Divisional 1st and 2nd in 4x100m Relay."},{year:"2025",title:"Academic & Quiz Competition Honor",desc:"J. Saravanan (Chemical Engineering) won the Online Quiz Competition 2025 hosted at Ramakrishna Vidyalaya on 08-08-2025, receiving a prestigious Cash Award of £1000."},{year:"2025",title:"Recent Industry Tie-ups & MoUs",desc:"Signed strategic MoUs with Magic Bus India Foundation, Navi Mumbai (31-07-2025) and Marks Engineering Works, Karumathampatti (25-07-2025) to enhance training and placements."}],achievementGallery:[{src:"/assets/departments/CHEM/Throw Ball.webp",title:"Sports Achievement",desc:"Chemical engineering students winning at state level sports events."},{src:"/assets/departments/CHEM/IPAA Basketball.webp",title:"Academic Honors",desc:"Students receiving awards for outstanding academic performance."},{src:"/assets/departments/CHEM/Chess.webp",title:"Symposium Prize Winners",desc:"Chemical Engineering students winning top prizes in paper presentation."},{src:"/assets/departments/CHEM/Online quizz.webp",title:"Quiz Competition Award",desc:"J. Saravanan receiving cash award at Online Quiz Competition."},{src:"/assets/departments/CHEM/Project Expo.webp",title:"Industry MoU Signings",desc:"Strategic partnership signing to enhance students' industry placement."}],ivGallery:[{src:"/assets/departments/CHEM/IV 1.webp",title:"Sakthi Sugars Limited",desc:"Industrial visit to Sakthi Sugars Limited, observing process crystallization."},{src:"/assets/departments/CHEM/IV 2.webp",title:"Benchmark Tea Factory",desc:"Students observing process technology at Ooty Tea and Chocolate Factory."},{src:"/assets/departments/CHEM/IV 3.webp",title:"Reverse Osmosis Plant",desc:"Field visit to learn about membrane filtration and water treatment."},{src:"/assets/departments/CHEM/IV 4.webp",title:"Project Expo KEC",desc:"Visit to the KEC Project Expo to explore innovative food & chemical setups."}],labGallery:[{src:"/assets/departments/selected/chemical selected/CHEM (1).webp",title:"Unit Operations Laboratory",desc:"Distillation columns, filtration units, and evaporators."},{src:"/assets/departments/selected/chemical selected/CHEM (5).webp",title:"Heat Transfer & Fluid Mechanics Lab",desc:"Heat exchangers, pumps, and fluid dynamics testing rigs."},{src:"/assets/departments/selected/chemical selected/CHEM (6).webp",title:"Mass Transfer Operations Lab",desc:"Absorption columns, liquid extraction, and drying units."},{src:"/assets/departments/selected/chemical selected/CHEM (7).webp",title:"Chemical Reaction Engineering Lab",desc:"Batch reactors, CSTR, and kinetics analysis apparatus."},{src:"/assets/departments/selected/chemical selected/CHEM (13).webp",title:"Process Instrumentation & Control Lab",desc:"Control valves, sensors, and PID controller setups."},{src:"/assets/departments/selected/chemical selected/CHEM (17).webp",title:"Technical Analysis & Chemistry Lab",desc:"Spectrophotometers, titrators, and chemical analytical tools."}],events:[{date:"30 Jul 2026",title:"Guest Lecture on 'Importance of Chemical Engineering in Oil and Gas'",type:"Guest Lecture",speaker:"Mr. N. John Batsha",designation:"Senior Operator",organization:"ADNOC Gas, Abu Dhabi",desc:"On behalf of the Department of Chemical Engineering Association, a Guest Lecture was conducted on the topic 'Importance of Chemical Engineering in Oil and Gas' on 30.07.2026. The lecture was delivered by Mr. N. John Batsha, Senior Operator, ADNOC Gas, Abu Dhabi. The programme was organized to provide students with valuable insights into the role of chemical engineering in the oil and gas industry and to enhance their technical knowledge through interaction with an experienced industry professional.",outcomes:["Understand the critical role of chemical engineers across upstream, midstream, and downstream oil and gas operations.","Gain insights into natural gas processing, fractionation, separation technologies, and plant safety standards.","Explore international career pathways, technical competencies, and operational benchmarks in the global energy sector.","Interact directly with an experienced industry professional from ADNOC Gas, Abu Dhabi."],industryExposure:"Direct global industry exposure to multinational oil and gas operations and plant safety standards from ADNOC Gas, Abu Dhabi."},{date:"24 Jul 2026",title:"Industrial Visit to Kanan Devan Hills Plantations Company (KDHP)",type:"Industrial Visit",location:"High Ranges, Idukki District, Kerala",venue:"Kanan Devan Hills Plantations Company Pvt Ltd, Munnar",participants:"Chemical Engineering Students and Faculty Members",desc:"The Department of Chemical Engineering organized an Industrial Visit to Kanan Devan Hills Plantations Company Private Limited (KDHP) on 24.07.2026. KDHP is the largest employee-owned tea company in the world and the largest tea corporate in South India, covering 23,783 hectares in the High Ranges of Idukki District, Kerala. Students observed industrial unit operations including tea leaf withering, rolling, fermentation kinetics, fluid bed drying, grading, and packaging, alongside KDHP's unique Participatory Management System.",outcomes:["Observe industrial food processing operations, mass transfer, drying kinetics, and automated grading.","Understand the role of temperature, humidity, and airflow control in fermentation and moisture reduction.","Gain insights into large-scale plant operations, quality control certifications, and sustainable agro-processing.","Learn about KDHP's unique employee-owned Participatory Management System and corporate governance."],industryExposure:"Industrial processing operations and participatory corporate management at South India's largest tea enterprise (KDHP)."},{date:"14 Jul 2026",title:"Industrial Visit to Indian Stitches Private Limited",type:"Industrial Visit",location:"SIPCOT, Perundurai",venue:"Indian Stitches Private Limited, SIPCOT Industrial Park",participants:"Chemical Engineering Students and Faculty Members",desc:"The Department of Chemical Engineering organized an Industrial Visit to Indian Stitches Private Limited at SIPCOT, Perundurai on 14.07.2026. Indian Stitches is a leading vertically integrated textile manufacturer specializing in knitted fabric exports with a dyeing capacity of 27 tons/day (85,000 meters/day) and an all-over printing capacity of 13 tons/day (40,000 meters/day). Students gained practical exposure to textile wet processing, chemical formulation, reactive dyeing, fixation, and observed their state-of-the-art Effluent Treatment Plant (ETP) featuring advanced water recycling and zero liquid discharge (ZLD).",outcomes:["Understand industrial textile chemical wet processing, color formulation, and reactive dyeing operations.","Observe all-over printing techniques, fabric drying, and finishing processes operating at commercial scale.","Study the working principles of modern industrial Effluent Treatment Plants (ETP) and membrane filtration.","Understand sustainable chemical engineering practices, water recovery, and zero liquid discharge (ZLD) systems."],industryExposure:"Comprehensive exposure to commercial textile wet processing and advanced zero liquid discharge ETP recycling at Indian Stitches."},{date:"11 Feb 2026",title:"Guest Lecture on Industrial Wastewater Treatment",type:"Guest Lecture",speaker:"Mr. P. Suresh Anand, B.E., AMIE (Civil)",designation:"Manager",organization:"Memzio Water Engineering, Perundurai",venue:"Kalingarayan Seminar Hall",time:"10:30 A.M.",outcomes:["Understand effluent treatment processes and environmental standards.","Analyze biological and chemical wastewater treatment methods.","Familiarize with industrial filtration, sludge handling, and water recycling."]},{date:"21 Jan 2026",title:"Technical Symposium Jury & Paper Presentation",type:"Symposium",speaker:"D. Sathiya & K. Prasanthkumar (Juries)",designation:"Faculty Juries",organization:"Kongu Polytechnic College",venue:"Seminar Hall",outcomes:["Evaluated 12 technical paper submissions on high-gravity separation, bioplastics, and next-generation lithium-ion batteries.","Selected 6 outstanding papers for awards based on technical merit.","Encouraged presentation and scientific communication skills among students."]},{date:"12 Sep 2025",title:"Industrial Visit to Sakthi Sugars Limited",type:"Industrial Visit",location:"Appakudal",venue:"Sakthi Sugars Limited Plant",outcomes:["Observe industrial-scale crushing, evaporation, and crystallization operations.","Understand waste heat recovery, steam generation, and co-generation technologies.","Observe sugar refining and distillation operations in process plants."]},{date:"22 Aug 2025",title:"Project Expo 2025 Visit",type:"Field Visit",location:"Kongu Engineering College",venue:"KEC Department of Chemical & Food Technology",outcomes:["Explore innovative student projects in chemical and food technology.","Interact with senior students and research scholars.","Gain inspiration for final-year project developments."]},{date:"13 Aug 2025",title:"Field Visit to RO Plant",type:"Field Visit",location:"KEC Campus",venue:"KEC Reverse Osmosis Treatment Plant",outcomes:["Understand membrane separation processes and filtration stages.","Analyze water quality testing and chemical dosage methods.","Gain hands-on knowledge on pump operations and filter maintenance."]},{date:"08 Aug 2025",title:"Industrial Visit to Benchmark Tea and Chocolate Factory",type:"Industrial Visit",location:"Ooty",venue:"Benchmark Tea & Chocolate Factory",outcomes:["Observe food process technology and raw materials handling.","Understand mass transfer, heat transfer, and drying operations in food production.","Observe packaging automation and quality control standards in production."]},{date:"04 Jul 2025",title:"Association Guest Lecture on Dynamic Simulation",type:"Guest Lecture",speaker:"Dr. M. Suresh Kumar, Ph.D",designation:"Manager - Training Division",organization:"SIM Infosystems Private Limited, Chennai",venue:"Department Seminar Hall",time:"10:30 A.M.",outcomes:["Understand the concepts of dynamic simulation in chemical processes.","Familiarize with PROSIMULATOR software applications in process control.","Identify industry expectations for process modeling and control engineers."]}],icon:(0,a.jsxs)("svg",{className:"w-6 h-6",fill:"none",stroke:"url(#dg-chem)",strokeWidth:"2",viewBox:"0 0 24 24",children:[(0,a.jsx)("defs",{children:(0,a.jsxs)("linearGradient",{id:"dg-chem",x1:"0%",y1:"0%",x2:"0%",y2:"100%",children:[(0,a.jsx)("stop",{offset:"0%",stopColor:"#91C04A"}),(0,a.jsx)("stop",{offset:"100%",stopColor:"#009EDB"})]})}),(0,a.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",d:"M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"})]})},{id:"auto",slug:"auto",name:"Automobile Engineering",fullName:"Automobile Engineering",established:1999,intake:60,duration:"3 Years",syllabus:"/assets/departments/Automobile/Regulation 2023  -  1021 Automobile Engineering.pdf",image:"https://images.unsplash.com/photo-1517524206127-48bbd363f3d7?auto=format&fit=crop&w=600&q=80",slogan:"Engineering excellence in automotive technology.",description:"The Department of Automobile Engineering was established in 1999. The department has been offering quality technical education in the field of Automobile Engineering and Electric Vehicle Technology for many years.",overviewBullets:["The Department of Automobile Engineering was established in 1999.","The department has an annual intake of 60 students.","Offers quality technical education in the field of Automobile Engineering and Electric Vehicle Technology.","Provides knowledge in Automotive Engineering and E-Vehicle Technology.","Students learn about Automotive Engines, Automotive Electrical Engineering, Chassis and Transmission, Battery Management, Electric Vehicle technology, and Hybrid Vehicle technology.","Curriculum includes basic concepts of Automotive, Emission and control, Fuels and combustion technology.","Helps students develop technical and practical skills required for the automobile industry."],vision:"To produce competent automobile engineering professionals with strong technical knowledge, practical skills, professional ethics, and lifelong learning abilities to meet the needs of the evolving automotive industry.",mission:["Deliver quality technical education and hands-on practical training in automotive engineering and EV technology.","Bridge the gap between theoretical knowledge and industrial practices through industrial visits and field training.","Foster innovation, safety awareness, and ethical responsibility in student developments.","Nurture career opportunities and entrepreneurship in core automotive and allied industries."],labs:["Automotive Engines Lab","Automotive Electrical & Electronics Lab","Chassis and Transmission Lab","Electric & Hybrid Vehicle Technology Lab","Fuels and Combustion Technology Lab","Vehicle Maintenance & Servicing Lab"],careers:["TNSTC (Tamil Nadu State Transport Corporation)","Road Transport Officer (RTO)","PWD (Public Works Department)","Employment in Automobile and Mechanical Industries","Job opportunities in government, public sector, and private organizations","Opportunities to work in India and abroad","Entrepreneurship in vehicle servicing and maintenance sectors"],keyStrengths:["Experienced faculty members.","Well-equipped laboratories.","Industry-oriented learning.","Focus on practical knowledge and skill development.","Good career opportunities in the Automobile field."],hodMessage:"Automobile Engineering is designed to equip students with strong theoretical knowledge and practical skills in automotive technology. It is committed to providing quality technical education through experienced faculty, modern laboratories, industrial visits and hands on training. We encourage students to develop technical competence, innovation, professional ethics and lifelong learning skills to meet the demands of the rapidly evolving automobile industry.",faculty:[{name:"K Ravichandran",designation:"SG1-HOD",doj:"21-07-2005",dob:"10-05-1978",qualification:"B.E., M.E., (Ph.D)",experience:"22 Years 4 Months",phone:"9842731255",image:"/assets/departments/Faculty/TEACHING kpc/AUTO/ravichandran.webp"},{name:"E.Govendan",designation:"SG1. Lecturer",doj:"17-11-2007",dob:"05-06-1984",qualification:"M.E.",experience:"19 Years 0 Months",phone:"9944820133",image:"/assets/departments/Faculty/TEACHING kpc/AUTO/kovendhan.webp"},{name:"K.Murugesan",designation:"Senior Lecturer",doj:"01-12-2010",dob:"26-04-1974",qualification:"B.E.",experience:"16 Years 6 Months",phone:"9842749191",image:"/assets/departments/Faculty/TEACHING kpc/AUTO/murugesan.webp"},{name:"P.Chandrasekar",designation:"Senior Lecturer",doj:"14-05-2012",dob:"03-07-1989",qualification:"B.E.",experience:"14 Years 1 Month",phone:"9842923399",image:"/assets/departments/Faculty/TEACHING kpc/AUTO/Chandrasekhar.webp"},{name:"K.P.Karthik",designation:"Lecturer",doj:"01-06-2017",dob:"27-07-1995",qualification:"B.E.",experience:"9 Years 0 Months",phone:"8072338018",image:"/assets/departments/Faculty/TEACHING kpc/AUTO/karthick.webp"},{name:"K.Sambathkumar",designation:"Instructor",doj:"14-05-2003",dob:"13-05-1978",qualification:"B.E.",experience:"23 Years 1 Month",phone:"9842948679",image:"/assets/departments/Faculty/NONTEACHING kpc/AUTO/sambath.webp"},{name:"L.Tamilvanaan",designation:"Workshop Instructor",doj:"07-08-2007",dob:"25-05-1984",qualification:"ITI",experience:"18 Years 8 Months",phone:"9677819977",image:"/assets/departments/Faculty/NONTEACHING kpc/AUTO/tamil.webp"},{name:"C.Gowtham",designation:"Lab Assistant",doj:"02-07-2022",dob:"28-01-2002",qualification:"DME",experience:"3 Years 11 Months",phone:"6374722124",image:"/assets/departments/Faculty/NONTEACHING kpc/AUTO/gowtham.webp"}],alumni:[{name:"S. Suresh",batch:"Alumnus",salary:"50 Lakh/Annum",position:"Logistics Coordinator",company:"Kobelco Shipping Logistics and Transport",location:"Europe",image:"/assets/departments/Automobile/Suresh S.webp"},{name:"K. Balasubramaniam",batch:"Alumnus",salary:"45 Lakh/Annum",position:"Commissioning & Plant start up HSE Engineer",company:"Maire E&C",location:"UAE",image:"/assets/departments/Automobile/Balasubramaniam K.webp"},{name:"Amaljith VP",batch:"Alumnus",salary:"45 Lakh/Annum",position:"Senior Export Sales Officer",company:"Mitsubishi",location:"Dubai",image:"/assets/departments/Automobile/Amalajith VP.webp"},{name:"Shreedhar M",batch:"Alumnus",salary:"14 Lakh/Annum",position:"Design Lead (Automotive front and rear lighting)",company:"Valeo India Private Limited",location:"Chennai",image:"/assets/departments/Automobile/Shreedhar M.webp"},{name:"Nagarjun P",batch:"Alumnus",salary:"11 Lakh/Annum",position:"Senior Engineer - Quality Assurance",company:"Hyundai Motor India",location:"Sriperumbudur",image:"/assets/departments/Automobile/Nagarjun P.webp"},{name:"Moulidharan R",batch:"Alumnus",salary:"11 Lakh/Annum",position:"Team Lead - Quality",company:"Flextronics Technologies India Pvt Ltd (Global Business Service)",location:"Coimbatore",image:"/assets/departments/Automobile/Moulidharan R.webp"},{name:"N Karthick",batch:"Alumnus",salary:"10 Lakh/Annum",position:"Process Associate",company:"Genpact India Pvt Ltd",location:"Hyderabad",image:"/assets/departments/Automobile/Karthick N.webp"},{name:"Santhosh B",batch:"Alumnus",salary:"10 Lakh/Annum",position:"Associate",company:"India Yamaha Motor Pvt Ltd",location:"Sriperumbudur",image:"/assets/departments/Automobile/Santhosh B.webp"},{name:"Karthik",batch:"Alumnus",salary:"10 Lakh/Annum",position:"Senior Quality Engineering",company:"Acendion",location:"Coimbatore",image:"/assets/departments/Automobile/Karthik.webp"},{name:"Yuvaramakrishnaa",batch:"Alumnus",salary:"10 Lakh/Annum",position:"Assistant Manager Project",company:"Janatics",location:"Coimbatore",image:"/assets/departments/Automobile/Yuvaramakrishnaa.webp"},{name:"Ranjith K S",batch:"Alumnus",salary:"9 Lakh/Annum",position:"Senior Failure Analysis Engineer",company:"L&T Technology Services",location:"Chennai",image:"/assets/departments/Automobile/Ranjith KS.webp"}],ivGallery:[{src:"/assets/departments/Automobile/FIELD VISIT 1.webp",title:"Field Visit",desc:"Automobile engineering students observing industry machinery during a field visit."},{src:"/assets/departments/Automobile/FIELD VISIT 2.webp",title:"Field Visit Observations",desc:"Students during practical on-site industry learning."},{src:"/assets/departments/Automobile/Inaugaral Function.webp",title:"Inaugural Function",desc:"Inauguration ceremony of the Automobile Association activities."},{src:"/assets/departments/Automobile/Valedictory function.webp",title:"Valedictory Function",desc:"Valedictory function celebrating student accomplishments and events."}],labGallery:[{src:"/assets/departments/selected/Auto Selected/AUTO (5).webp",title:"Automotive Engines Laboratory",desc:"Multi-cylinder petrol and diesel engine test rigs."},{src:"/assets/departments/selected/Auto Selected/AUTO (6).webp",title:"Chassis & Transmission Lab",desc:"Gearboxes, differentials, and suspension test benches."},{src:"/assets/departments/selected/Auto Selected/AUTO (8).webp",title:"Two & Three Wheeler Technology Lab",desc:"Vehicle overhaul, servicing, and performance tuning."},{src:"/assets/departments/selected/Auto Selected/AUTO (11).webp",title:"Autotronics & EV Diagnostics Lab",desc:"Modern automotive sensors, ECUs, and scan tools."},{src:"/assets/departments/selected/Auto Selected/AUTO (15).webp",title:"Vehicle Maintenance & Reconditioning Lab",desc:"Wheel alignment, brake testing, and tire changers."},{src:"/assets/departments/selected/Auto Selected/AUTO (17).webp",title:"Automobile Electrical Systems Lab",desc:"Wiring harnesses, starter motors, and alternators."},{src:"/assets/departments/selected/Auto Selected/AUTO (21).webp",title:"CAD for Automotive Design",desc:"Solid modeling and automotive component simulation."}],events:[{date:"02 Feb 2026",title:"Guest Lecture on 'ROAD SAFETY AND TRAFFIC RULES'",type:"Guest Lecture",speaker:"Mr. P. PREM KUMAR, M.Sc.",designation:"Inspector of Police",organization:"Traffic Police Station, Perundurai",venue:"Dheeran Chinnamalai Seminar Hall, KPC, Perundurai",time:"10:30 A.M.",outcomes:["Understand the traffic rules and regulations.","Gain knowledge of road safety.","Explore the importance of safety drive the vehicle.","Learn road signals and highway road rules.","Know about LLR and Licence for operating different vehicle."]},{date:"22 Dec 2025",title:"Field Visit to our KVITT Vehicle Maintenance shed",type:"Field Visit",location:"KVIT Trust campus, Perundurai",participants:"All II and III year Automobile Students and Faculty Members",venue:"KVITT Vehicle Maintenance shed",outcomes:["Understand the general vehicle maintenance.","Gain the systematic service and maintenance.","Learn about daily, weekly, monthly, three month, six month and yearly maintenance.","Understand wheel alignment and tyre rotation.","Develop awareness of safety equipment about maintenance.","Bridge the gap between theoretical concepts and industrial practices through hands-on observation."]},{date:"06 Aug 2025",title:"Special Lecture on 'RECENT TRENDS IN AUTOMOBILE'",type:"Special Lecture",speaker:"Mr. VIJAYAKUMAR P.N, B.E.",designation:"Proprietor",organization:"Jai Maruti Auto care, Mettukadai, Erode",venue:"KPC English Communication Lab",time:"10:30 A.M.",outcomes:["Understand the fundamentals and emerging trends in service technologies.","Gain knowledge of smart systems using concepts.","Explore the applications of modern technologies in modern cars.","Improve knowledge in service technology with modern technic to support efficiency.","Develop and aware of proper maintenance."]}],icon:(0,a.jsxs)("svg",{className:"w-6 h-6",fill:"none",stroke:"url(#dg-auto)",strokeWidth:"2",viewBox:"0 0 24 24",children:[(0,a.jsx)("defs",{children:(0,a.jsxs)("linearGradient",{id:"dg-auto",x1:"0%",y1:"0%",x2:"0%",y2:"100%",children:[(0,a.jsx)("stop",{offset:"0%",stopColor:"#91C04A"}),(0,a.jsx)("stop",{offset:"100%",stopColor:"#009EDB"})]})}),(0,a.jsx)("path",{d:"M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"}),(0,a.jsx)("circle",{cx:"7",cy:"17",r:"2"}),(0,a.jsx)("circle",{cx:"17",cy:"17",r:"2"}),(0,a.jsx)("path",{d:"M13 17H9"})]})},{id:"mechat",slug:"mechat",name:"Mechatronics Engineering",fullName:"Mechatronics Engineering",established:2005,intake:60,duration:"3 Years",syllabus:"/assets/departments/Mechatronics/1047_1049_2047 Mechatronics, Electronics(Robotics), Mechatronics(SW) (1).pdf",image:"https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&fit=crop&w=600&q=80",slogan:"Integrating mechanics, electronics, and intelligence.",description:"Mechatronics Engineering course was designed specially to cater the needs of modern industries where there is a requirement of personnel with skill in multiple fields such as Mechanical, Automobile, Electrical, Electronics and Automation Technologies.",overviewBullets:["The Department of Mechatronics Engineering was established in 2005.","The department has an annual intake of 60 students and offers a 3-year Diploma programme.","Specially designed to cater to modern industries requiring multi-disciplinary skills.","Bridges Mechanical, Automobile, Electrical, Electronics, and Automation Technologies.","Equipped with state-of-the-art laboratories featuring multi-axis robotics and industrial IoT setups."],labs:["Computer Center","Robotics Lab (featuring 5-Axis & 6-Axis Robot Machines)","Hydraulics & Pneumatic Lab (in Collaboration with M/s. Fluidics Ltd, Janatics India Ltd and Mansco Pvt Ltd)","Process Control Lab (using DAQ & PC-based PLC/ SCADA Software)"],careers:["Controls Engineer / Senior Controls Engineer","Automation Engineer / Robotics Technician","Process Engineer / Manufacturing Specialist","Graduate Engineering Trainee (GET)","Machine Learning Data Specialist"],hodMessage:"Welcome to the Department of Mechatronics Engineering. The Department of Mechatronics Engineering was established in 2005 to cater to the needs of modern industries requiring personnel skilled in Mechanical, Automobile, Electrical, Electronics, and Automation Technologies. Our department is committed to imparting high-quality technical education and hands-on practical skills to prepare students for the rapidly evolving smart manufacturing and robotics sectors. With our state-of-the-art laboratory facilities, including multi-axis robots, process control DAQ systems, and hydraulics & pneumatics kits, we ensure that our students receive excellent training. I encourage all students to make the best use of these opportunities and strive for excellence in their careers.",faculty:[{name:"M. Gopalakrishnan",designation:"HOD",doj:"23.06.2008",dob:"10.07.1983",qualification:"M.E., MISTE",experience:"18 Years",phone:"9894831930",image:"/assets/departments/Faculty/TEACHING kpc/MTS/gopalakrishnan.webp"},{name:"R. Parvatham",designation:"SG1 Lecturer",doj:"21.05.2003",dob:"01.10.1977",qualification:"M.E., MISTE",experience:"23 Years",phone:"9500299500",image:"/assets/departments/Faculty/TEACHING kpc/MTS/parvatham.webp"},{name:"G. Prabhakaran",designation:"SG1 Lecturer",doj:"17.05.2010",dob:"08.04.1984",qualification:"M.E., MISTE",experience:"16 Years",phone:"9943186909",image:"/assets/departments/Faculty/TEACHING kpc/MTS/prabhakaran.webp"},{name:"R. Nagarani",designation:"SG1 Lecturer",doj:"11.06.2007",dob:"10.04.1975",qualification:"M.E., MISTE",experience:"19 Years",phone:"7373998650",image:"/assets/departments/Faculty/TEACHING kpc/MTS/nagarani.webp"},{name:"E. Abishanth",designation:"Sr. Lecturer",doj:"27.05.2015",dob:"05.10.1993",qualification:"B.E., MISTE",experience:"11 Years",phone:"8883418188",image:"/assets/departments/Faculty/TEACHING kpc/MTS/abhishanth.webp"},{name:"C. Prakash",designation:"Workshop Instructor",doj:"01.08.2008",dob:"20.05.1988",qualification:"ITI",experience:"18 Years",phone:"9865149983",image:"/assets/departments/Faculty/NONTEACHING kpc/MTS/prakash.webp"}],alumni:[{name:"Syed Mohamed buhari J Y",batch:"DMR 2020-23",salary:"3.0 Lakh/Annum",position:"GET graduate engineering trainee",company:"MOTHERSON",location:"Chennai",image:""},{name:"SUJITH T",batch:"DMR 2020-23",salary:"3.0 Lakh/Annum",position:"GET graduate engineering trainee",company:"MOTHERSON",location:"Chennai",image:"/assets/departments/Mechatronics/Sujith T.webp"},{name:"RAGHUL Y",batch:"MTS 2020-23",salary:"3.5 Lakh/Annum",position:"PROCESS ENGINEER",company:"TATA ELECTRONICS Pvt. Ltd",location:"Hosur",image:"/assets/departments/Mechatronics/Raghul Y.webp"},{name:"CIBIVARSHAN M",batch:"DMR 2020-23",salary:"3.2 Lakh/Annum",position:"Control Engineer",company:"SYNAPSE ROBOTICS",location:"Coimbatore",image:"/assets/departments/Mechatronics/Cibivarshan M.webp"},{name:"DHANAPRASATH P",batch:"DMR 2014-17",salary:"6.0 Lakh/Annum",position:"Senior Controls Engineer",company:"ENRX",location:"Bangalore",image:"/assets/departments/Mechatronics/Dhanaparasath P.webp"},{name:"JISHNU S",batch:"MTS 2018-2020",salary:"4.0 Lakh/Annum",position:"ASSOCIATE DEVELOPER",company:"VIZSET ANALYTICS PVT LTD",location:"Chennai",image:"/assets/departments/Mechatronics/Jishnu.webp"},{name:"PREETHIKA A",batch:"MTS 2019-2022",salary:"3.6 Lakh/Annum",position:"Mechanical Engineer",company:"Valeo India Private Ltd",location:"Chennai",image:"/assets/departments/Mechatronics/Preethika A.webp"},{name:"GOWRI M",batch:"DMR 2019-22",salary:"3.0 Lakh/Annum",position:"Machine Learning Data Specialist",company:"LabelBees",location:"Tiruchengode",image:"/assets/departments/Mechatronics/Gowri M.webp"}],placements:[{rollNo:"23DMR001",name:"Aruneshwaran A",image:"/assets/departments/Mechatronics/Aruneshwaran A.webp",offers:[{company:"Hyundai Motors India Limited, Chennai",salary:"2.64 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DMR002",name:"Dheenadhayalan M",image:"/assets/departments/Mechatronics/Dheenadhayalan M.webp",offers:[{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DMR003",name:"Ganeshkumar K",image:"/assets/departments/Mechatronics/Ganeshkumar K.webp",offers:[{company:"Hyundai Motors India Limited, Chennai",salary:"2.64 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DMR004",name:"Harish Kumar S",image:"/assets/departments/Mechatronics/Harishkumar S.webp",offers:[{company:"Hyundai Motors India Limited, Chennai",salary:"2.64 LPA"},{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DMR005",name:"Mohammed Fhahiz",image:"/assets/departments/Mechatronics/Mohammed Fhahiz.webp",offers:[{company:"Hyundai Motors India Limited, Chennai",salary:"2.64 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DMR006",name:"Naveenkumar M",image:"/assets/departments/Mechatronics/Naveenkumar M.webp",offers:[{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DMR007",name:"Santhosh R C",image:"/assets/departments/Mechatronics/Santhosh RC.webp",offers:[{company:"Hyundai Motors India Limited, Chennai",salary:"2.64 LPA"},{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DMR008",name:"Mohamed Aathil S",image:"/assets/departments/Mechatronics/Mohammed Aathil S.webp",offers:[{company:"Hyundai Motors India Limited, Chennai",salary:"2.64 LPA"},{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]},{rollNo:"23DMR009",name:"Mugesh M",image:"/assets/departments/Mechatronics/Mugesh M.webp",offers:[{company:"Hyundai Motors India Limited, Chennai",salary:"2.64 LPA"},{company:"Royal Enfield, Chennai",salary:"2.58 LPA"},{company:"MRF Tyres, Chennai",salary:"2.46 LPA"}]}],achievements:[{year:"2026",title:"Innovation Day Project Contest - 1st Prize",desc:"Kiruthik S K and Rohith S (III-Year MTS) won 1st Prize and received a cash award of ₹1,000 for Project Presentation at Nandha Engineering College, Erode."},{year:"2026",title:"Innovation Day Project Contest - 2nd Prize",desc:"Mohamed Aathil S and Ganesh Kumar K won 2nd Prize and received a cash award of ₹750 for Project Presentation at Nandha Engineering College, Erode."},{year:"2026",title:"IPAA Sports Hockey - Divisional 2nd Place",desc:"Mohan Raj A (II-Year MTS) and Manikandan K (III-Year MTS) secured Divisional Second Place in Hockey at Kongu Vellalar Polytechnic College."},{year:"2026",title:"IPAA Athletic Hammer Throw - State 1st & Divisional 1st Place",desc:"Mohan Raj A (II-Year MTS) secured Divisional First Place in Athletic Hammer Throw at Kongu Polytechnic College, and State First Place at MAM Polytechnic College, Trichy."},{year:"2025",title:"Recent Industry Tie-ups & MoUs",desc:"Signed strategic MoUs with Magic Bus India Foundation, Navi Mumbai and Marks Engineering Works, Karumathampatti to enhance student training and placements."}],labGallery:[{src:"/assets/departments/selected/mts selected/DSC06011.webp",title:"Robotics & Industrial Automation Lab",desc:"6-axis articulate robotic arms and motion controllers."},{src:"/assets/departments/selected/mts selected/MTS (1).webp",title:"Hydraulics & Pneumatics Lab",desc:"Electro-pneumatic and hydraulic trainers by Janatics."},{src:"/assets/departments/selected/mts selected/MTS (3).webp",title:"PLC & SCADA Control Lab",desc:"Industrial PLCs, HMIs, and sensor integration stations."},{src:"/assets/departments/selected/mts selected/MTS (4).webp",title:"Sensors & Signal Conditioning Lab",desc:"Transducers, optical encoders, and DAQ boards."},{src:"/assets/departments/selected/mts selected/mts2 (1).webp",title:"CNC & Microcontroller Lab",desc:"Microcontroller programming and CNC simulation units."},{src:"/assets/departments/selected/mts selected/mts2 (2).webp",title:"Mechatronics System Design Center",desc:"Integrated multi-disciplinary electromechanical workstations."}],ivGallery:[{src:"/assets/departments/Mechatronics/Benchmark Tea and Chocolate factory.webp",title:"Industrial Visit",desc:"Students at Benchmark Tea and Chocolate Factory, Ooty."},{src:"/assets/departments/Mechatronics/Field Visit @TBI.webp",title:"Field Visit",desc:"Interactive field visit to TBI @ KEC."},{src:"/assets/departments/Mechatronics/Project Expo.webp",title:"Project Expo",desc:"Students participating in Project Expo at Kongu Engineering College."}],events:[{date:"01 Sep 2026",title:"Association Session on 'Lean Manufacturing Tools'",type:"Association Function",speaker:"Mr. M. Shanmugam",designation:"Assistant Programme Manager, State Lead – Skills Development",organization:"Bosch India Foundation, Chennai",desc:"The Department of Mechatronics Engineering Association organized an interaction session on 01.09.2026 on the topic 'Lean Manufacturing Tools'. The session was led by Mr. M. Shanmugam, Assistant Programme Manager, State Lead – Skills Development, Bosch India Foundation, Chennai, who shared valuable insights on current industry trends, technical skills, employability, and the importance of continuous learning. The session provided students with practical exposure to real-world industry expectations and motivated them to enhance their skills for future career opportunities.",outcomes:["Understand core concepts of Lean Manufacturing, 5S, Kaizen, and waste elimination in industrial processes.","Gain valuable insights into current automotive and automation industry trends and technical skill requirements.","Understand industry employability benchmarks and the importance of continuous learning.","Enhance practical readiness for future careers in modern automated manufacturing environments."],industryExposure:"Direct industry insights on lean manufacturing and skill standards from Bosch India Foundation."},{date:"24 Jul 2026",title:"Industrial Visit to ISRO Propulsion Complex (IPRC)",type:"Industrial Visit",location:"Mahendragiri, Tamil Nadu",venue:"ISRO Propulsion Complex (IPRC), Mahendragiri",participants:"Mechatronics Engineering Students and Faculty Members",desc:"The Mechatronics Engineering Department of Kongu Polytechnic College organized an Industrial Visit to ISRO Propulsion Complex (IPRC), Mahendragiri on 24.07.2026. The visit provided students with deep exposure to rocket propulsion systems, cryogenics, high-altitude engine test facilities, assembly of launch vehicle liquid stages, and automated precision testing mechanisms employed in India's space missions.",outcomes:["Gain firsthand knowledge of liquid and cryogenic propulsion technologies used in ISRO launch vehicles.","Observe high-altitude test facilities, automated fluid control systems, and precision test rigs.","Understand the critical role of mechatronics, sensors, and automated control in aerospace propulsion.","Bridge theoretical electromechanical knowledge with real-world space mission propulsion systems."],industryExposure:"Direct exposure to advanced cryogenic propulsion testing and launch vehicle assembly at ISRO Propulsion Complex (IPRC)."},{date:"24 Feb 2026",title:"Workshop on 'Advanced Design Thinking for Product Development'",type:"Workshop",speaker:"Prof. S. Santhosh Kumar, M.E. & Mrs. K.K. Megavarthini, M.E.",designation:"AP/MTS",organization:"Kongu Engineering College",venue:"Department of Mechatronics Engineering, KEC",outcomes:["Understand modern design thinking concepts and product development workflows.","Gain hands-on experience in prototyping and design evaluation."]},{date:"19 Feb 2026",title:"Association Function on 'Design Thinking'",type:"Association Function",speaker:"Prof. S. Santhosh Kumar, M.E.",designation:"Department of Mechatronics Engineering",organization:"Kongu Engineering College",venue:"Kalingarayan Seminar Hall",outcomes:["Learn user-centric design frameworks for industrial mechatronics applications."]},{date:"22 Aug 2025",title:"Project Expo – 2025 Visit",type:"Field Visit",venue:"Kongu Engineering College",outcomes:["Inspect various interdisciplinary engineering projects, automation designs, and robotic exhibits."]},{date:"25 Jul 2025",title:"Industrial Visit to Benchmark Tea & Chocolate Factory",type:"Industrial Visit",venue:"Benchmark Tea and Chocolate factory, Ooty",outcomes:["Observe food processing automation, automated packaging lines, and machinery operations."]},{date:"23 Jul 2025",title:"Field Visit to TBI @ KEC",type:"Field Visit",venue:"TBI @ KEC",outcomes:["Explore entrepreneurship pathways, incubation support, and innovative product prototypes."]}],icon:(0,a.jsxs)("svg",{className:"w-6 h-6",fill:"none",stroke:"url(#dg-mechat)",strokeWidth:"2",viewBox:"0 0 24 24",children:[(0,a.jsx)("defs",{children:(0,a.jsxs)("linearGradient",{id:"dg-mechat",x1:"0%",y1:"0%",x2:"0%",y2:"100%",children:[(0,a.jsx)("stop",{offset:"0%",stopColor:"#91C04A"}),(0,a.jsx)("stop",{offset:"100%",stopColor:"#009EDB"})]})}),(0,a.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",d:"M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"})]})},{id:"inst",slug:"inst",name:"Instrumentation & Control Engineering",fullName:"Instrumentation & Control Engineering",established:2005,intake:30,duration:"3 Years",syllabus:"/assets/departments/I&C/1042 Instrumentation & Control Engineering.pdf",image:"https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=600&q=80",slogan:"Precision in measurement, excellence in control.",description:"The Department of Instrumentation & Control Engineering, established in 2005, has been functioning with excellence and dedication towards producing competent engineers required for the rapidly evolving industrial and technological sectors. Our department provides students with a strong academic foundation in areas such as industrial instrumentation, process control, sensors and transducers, automation, programmable logic controllers (PLC), embedded systems, industrial communication, and modern control technologies.",overviewBullets:["The Instrumentation & Control Engineering department started functioning from the year 2006.","The department has an annual intake of 30 students.","It has been offering quality technical education in the field of Instrumentation & Control Engineering for many years.","The department provides knowledge in Instrumentation Engineering, Control Systems, and Industrial Automation.","Students develop technical, analytical, and practical skills required for modern industries."],coreAreas:["Measurement and Instrumentation Techniques","Process Control Systems","Sensors and Transducers","Industrial Automation and PLC/SCADA Systems","Electronics and Embedded Systems","Control Engineering","Industrial Automation"],labs:["Process Instrumentation Lab","Industrial Sensors & Calibration Lab","Virtual Instrumentation (LabVIEW) Lab","Distributed Control Systems (DCS) Lab"],careers:["Jobs in process industries such as oil & gas, power plants, and manufacturing sectors.","Opportunities in instrumentation and automation industries.","Careers in installation, calibration, and maintenance of industrial instruments.","Employment in automation, robotics, and control system industries.","Job opportunities in government organizations, public sector units, and private companies.","Opportunities to work in India and abroad in diverse industrial sectors."],keyStrengths:["Experienced and skilled faculty members.","Well-equipped laboratories with modern instrumentation and automation tools.","Industry-oriented curriculum with hands-on training.","Strong focus on practical knowledge, innovation, and skill development.","Excellent career opportunities in instrumentation, automation, and control engineering fields."],hodMessage:"Welcome to the Department of Instrumentation & Control Engineering. The Department of Instrumentation & Control Engineering, established in 2005, has been functioning with excellence and dedication towards producing competent engineers required for the rapidly evolving industrial and technological sectors. Our department provides students with a strong academic foundation in areas such as industrial instrumentation, process control, sensors and transducers, automation, programmable logic controllers (PLC), embedded systems, industrial communication, and modern control technologies. We continuously focus on enhancing both the theoretical knowledge and practical skills of our students through well-equipped laboratories, industrial visits, internships, seminars, workshops, technical training programmes, and project-based learning activities. Our experienced faculty members are committed to guiding students in developing technical expertise, analytical thinking, problem-solving abilities, leadership qualities, time management skills, teamwork, innovation, and professional ethics. I encourage every student to make the best use of the opportunities provided by the department and the institution and strive for excellence in both their academic and professional careers.",faculty:[{name:"Prakash M",designation:"HOD I/C",doj:"23-05-2011",dob:"22-03-1989",qualification:"B.E., MISTE",experience:"15 Years 1 Month",phone:"9791222872",image:"/assets/departments/Faculty/TEACHING kpc/I&C/prakash.webp"},{name:"Venkateswaran S",designation:"Sr. Lecturer",doj:"06-12-2010",dob:"02-01-1988",qualification:"B.E.",experience:"15 Years 7 Months",phone:"9791986065",image:"/assets/departments/Faculty/TEACHING kpc/I&C/venkatesh.webp"},{name:"Sangeetha S",designation:"Lecturer",doj:"01-06-2017",dob:"10-06-1996",qualification:"B.E.",experience:"3 Years 5 Months",phone:"8754206499",image:"/assets/departments/Faculty/TEACHING kpc/I&C/DSC04274.webp"},{name:"Karuppanan R",designation:"Workshop Instructor",doj:"30-11-2007",dob:"12-02-1978",qualification:"ITI",experience:"18 Years 7 Months",phone:"9944917276",image:"/assets/departments/Faculty/NONTEACHING kpc/I&C/karuppanan.webp"}],alumni:[{name:"SABAREESH R",batch:"2011 – 2014 Batch",salary:"10 Lakh/Annum",position:"3D Fashion Designer",company:"Gap Inc.",location:"Delhi",image:"/assets/departments/I&C/Sabareesh R.webp"},{name:"SACHIN MOHAN",batch:"2014 – 2017 Batch",salary:"10 Lakh/Annum",position:"Calibration department incharge",company:"Geo science testing laboratory",location:"Abudhabi",image:"/assets/departments/I&C/Sachin Mohan.webp"},{name:"JISHAN",batch:"2014 – 2017 Batch",salary:"15 Lakh/Annum",position:"General Manager",company:"Algate international",location:"United Kingdom",image:"/assets/departments/I&C/Jishan.webp"},{name:"MEGANATHAN",batch:"2014 – 2017 Batch",salary:"15 Lakh/Annum",position:"Design Engineer II",company:"ACL Digital",location:"Bangalore",image:"/assets/departments/I&C/Meghanathan.webp"},{name:"SAKTHIVEL S",batch:"2014 – 2017 Batch",salary:"15 Lakh/Annum",position:"Deputy Manager - Procurement",company:"Saipem India Projects",location:"Chennai",image:"/assets/departments/I&C/Sakthivel S.webp"},{name:"AJITHKUMAR P",batch:"2014 – 2017 Batch",salary:"9 Lakh/Annum",position:"Executive Engineer",company:"Cetex petrochemical ltd",location:"Manali",image:"/assets/departments/I&C/Ajithkumar P.webp"},{name:"HARI VIGNESH T",batch:"2015 – 2018 Batch",salary:"10 Lakh/Annum",position:"Maintenance engineer",company:"TATA Electronics",location:"Hosur",image:"/assets/departments/I&C/Hari Vignesh.webp"},{name:"PRABHU K",batch:"2015 – 2018 Batch",salary:"10 Lakh/Annum",position:"Software Engineer",company:"Robert Bosch",location:"Coimbatore",image:"/assets/departments/I&C/Prabhu K.webp"},{name:"KARTHIKEYAN R S",batch:"2017 – 2020 Batch",salary:"9 Lakh/Annum",position:"Quality engineer",company:"GE VERNOVA",location:"Chennai",image:"/assets/departments/I&C/Karthikeyan R.webp"},{name:"KAVIN",batch:"2018 – 2021 Batch",salary:"9 Lakh/Annum",position:"Automation Senior designer",company:"Base control tech fzc",location:"Sharjah, UAE",image:"/assets/departments/I&C/Kavin.webp"},{name:"M.GOPALAKRISHNAN",batch:"2021 – 2024 Batch",salary:"3.6 Lakh/Annum",position:"Jot (junior officer trainee)",company:"SPIC",location:"Thoothukudi",image:"/assets/departments/I&C/Gopalakrishnan M.webp"},{name:"NAGAKANNAN.M",batch:"2014 – 2017 Batch",salary:"15 Lakh/Annum",position:"Senior engineer",company:"Quest global",location:"Chennai",image:"/assets/departments/I&C/Nagakannan M.webp"},{name:"MOHAMMED FAISAL",batch:"2014 – 2017 Batch",salary:"10 Lakh/Annum",position:"Chief Operating Officer",company:"Famya Fabrication and Engineering Private Limited",location:"Thoothukudi, Odisha, Mumbai",image:"/assets/departments/I&C/Mohammed Faisal.webp"},{name:"SANJAIRAJ.P",batch:"2022 – 2025 Batch",salary:"2.80 Lakh/Annum",position:"Technician training",company:"Cetex petrol chemicals",location:"Manali",image:"/assets/departments/I&C/Sanjairaj P.webp"},{name:"RAGUL.C",batch:"2022 – 2025 Batch",salary:"3 Lakh/Annum",position:"Worker",company:"Seshasayee Paper And Boards Ltd",location:"Cauvery R.S",image:"/assets/departments/I&C/Ragul C.webp"},{name:"KALAIVANI K",batch:"2022 – 2025 Batch",salary:"3 Lakh/Annum",position:"Quality inspection Assistant",company:"Schneider electric india private limited",location:"Coimbatore",image:"/assets/departments/I&C/Kalaivani K.webp"},{name:"SUBASHREE",batch:"2022 – 2025 Batch",salary:"3.50 Lakh/Annum",position:"Diploma trainee",company:"Technip Energies",location:"Chennai",image:"/assets/departments/I&C/Subashree.webp"}],placements:[{rollNo:"23DIC001",name:"Manikandan K",image:"/assets/departments/I&C/Manikandan K.webp",offers:[{company:"VA TECH WABAG, CHENNAI",salary:"3.30 LPA"}]},{rollNo:"23DIC002",name:"Punitheeswaran M",image:"/assets/depar