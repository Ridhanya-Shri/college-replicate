nal Institutions."}],achievementGallery:[{src:"/assets/departments/BS/Achievement-Project Presentation.webp",title:"Project Presentation at Skill Plus",desc:"Award winning project presentation team."}],ivGallery:[{src:"/assets/departments/BS/Orientation Program.webp",title:"Orientation Programme",desc:"Orientation session for first year students."},{src:"/assets/departments/BS/Inaugural function.webp",title:"Inaugural Function",desc:"Dignitaries and students at the inaugural function."},{src:"/assets/departments/BS/Orientation Program 2.webp",title:"Yoga Session",desc:"Students practicing yoga during the orientation programme."},{src:"/assets/departments/BS/Club Activities img 1.webp",title:"Club Activities",desc:"Students participating in various drawing and culinary club activities."}],labGallery:[{src:"/assets/departments/selected/first year slected/FIRST YEAR (1).webp",title:"Engineering Physics Laboratory",desc:"Optics, spectrometers, lasers, and ultrasonic interferometers."},{src:"/assets/departments/selected/first year slected/FIRST YEAR (4).webp",title:"Engineering Chemistry Laboratory",desc:"Titration stations, pH meters, and water hardness analysis."},{src:"/assets/departments/selected/first year slected/FIRST YEAR (7).webp",title:"First Year Applied Science Lab",desc:"Fundamental scientific experimentation setups."},{src:"/assets/departments/selected/first year slected/FIRST YEAR (9).webp",title:"Basic Electrical & Electronics Lab",desc:"Foundational circuits and components training for freshers."},{src:"/assets/departments/selected/first year slected/FIRST YEAR (11).webp",title:"Interactive Science Demonstration Hall",desc:"Modern AV-enabled science learning space."},{src:"/assets/departments/selected/first year slected/FIRST YEAR (17).webp",title:"English Communication & Language Lab",desc:"Digital audio-visual consoles for language skills."},{src:"/assets/departments/selected/first year slected/FIRST YEAR (18).webp",title:"Applied Mathematics & Tutorial Center",desc:"Interactive problem solving and analytical reasoning space."},{src:"/assets/departments/selected/first year slected/FIRST YEAR (22).webp",title:"Foundational Engineering Workshop",desc:"Hands-on basic carpentry, fitting, and sheet metal practice."},{src:"/assets/departments/selected/first year slected/FIRST YEAR (23).webp",title:"Engineering Drawing & Drafting Hall",desc:"Spacious drafting tables and drawing instruments."},{src:"/assets/departments/selected/first year slected/FIRST YEAR LATHE (1).webp",title:"First Year Turning & Lathe Workshop",desc:"Foundational machine shop practice for beginners."},{src:"/assets/departments/selected/first year slected/FIRST YEAR LATHE (3).webp",title:"Workshop Lathe Practice",desc:"Precision turning, facing, and chamfering training."},{src:"/assets/departments/selected/first year slected/FIRST YEAR LATHE (5).webp",title:"Lathe Machinery Demonstration",desc:"Machine tool fundamentals and safety instructions."},{src:"/assets/departments/selected/first year slected/FIRST YEAR LATHE (9).webp",title:"Practical Machining Practice",desc:"Individual hands-on machining workstations."}],icon:(0,a.jsxs)("svg",{className:"w-6 h-6",fill:"none",stroke:"url(#dg-sci)",strokeWidth:"2",viewBox:"0 0 24 24",children:[(0,a.jsx)("defs",{children:(0,a.jsxs)("linearGradient",{id:"dg-sci",x1:"0%",y1:"0%",x2:"0%",y2:"100%",children:[(0,a.jsx)("stop",{offset:"0%",stopColor:"#91C04A"}),(0,a.jsx)("stop",{offset:"100%",stopColor:"#009EDB"})]})}),(0,a.jsx)("path",{strokeLinecap:"round",strokeLinejoin:"round",d:"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"})]})}];e.s(["departmentsData",0,n])}]);