",designation:"Lecturer / English",qualification:"M.A.,",doj:"01.06.2025",dob:"11.10.2002",experience:"0 Years 9 Months",phone:"7094916124",image:"/assets/departments/Faculty/TEACHING kpc/BCS/sowmi.webp"},{name:"Ms. Tamilselvi S.",designation:"Lecturer / English",qualification:"M.A., M.Phil., B.Ed.,",doj:"01.06.2026",dob:"25.05.1981",experience:"10 Years 0 Months",phone:"9842773409",image:"/assets/departments/Faculty/TEACHING kpc/BCS/TAMIL SELVI S.webp"}],events:[{date:"16 Sep 2025",title:"Club Activities – Drawing, Fruits Carving, Soap Carving & Fireless Cooking",type:"Club Activity",venue:"Kongu Polytechnic College",time:"1:30 P.M.",outcomes:["Foster creativity and artistic expression among students.","Encourage teamwork and participation in extra-curricular activities.","Develop hands-on creative and culinary skills."]},{date:"10 Jul 2025 (FN)",title:"Orientation Programme – Inspiration and Innovation",type:"Orientation Programme",speaker:"Dr. P. S. Kannan",designation:"General Manager, Kongu TBI",venue:"Maharaja Auditorium",time:"10:30 A.M.",outcomes:["Encourage students to think creatively and pursue innovative ideas.","Develop academic growth and future career.","Highlight the role of inspiration and innovation."]},{date:"09 Jul 2025 (AN)",title:"Orientation Programme – Blue Print for Success",type:"Orientation Programme",speaker:"Dr. S. C. Vetrivel",designation:"Associate Professor, Department of Management Studies",venue:"Maharaja Auditorium",time:"1:30 P.M.",outcomes:["Guidance on Academic planning.","Maintaining time Management.","Structure pathway to help students achieve their goals."]},{date:"09 Jul 2025 (FN)",title:"Orientation Programme – Role of Yoga",type:"Orientation Programme",speaker:"Dr. K. Shahana & Dr. P. G. Ahalya",designation:"Associate Professor, Kongu Naturopathy and Yoga Medical College",venue:"Maharaja Auditorium",time:"10:30 A.M.",outcomes:["Improving Concentration.","Managing Stress.","Maintaining overall Wellness."]},{date:"08 Jul 202